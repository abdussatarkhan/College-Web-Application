@model College_Web_Application.Models.ViewModels.EnterMarksViewModel
@{
    ViewData["Title"] = $"Enter Marks - {Model.CourseCode} ({Model.CourseTitle})";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Assigned Subjects</a></li>
                <li class="breadcrumb-item active">@Model.CourseCode - Award List</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-dark mb-1">
            @Model.CourseCode: @Model.CourseTitle
        </h4>
        <div class="text-muted small">
            Program: <strong>@Model.ProgramTitle</strong> | Semester: <strong>@Model.Semester</strong> | Section: <strong>@Model.Section</strong> | Session: <strong>@Model.AcademicSession</strong> | Cr.Hrs: <strong>@Model.CreditHours</strong>
        </div>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Workload
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- STATUS BANNER & WORKFLOW LOCK STATE -->
@if (Model.Status == College_Web_Application.Models.ExamSubmissionStatus.SubmittedToController)
{
    <div class="alert alert-warning border-warning d-flex align-items-center shadow-sm p-3 mb-4 rounded-3">
        <i class="bi bi-lock-fill fs-3 text-warning me-3"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-dark">Award List Submitted to Controller of Examinations (LOCKED)</h6>
            <div class="small text-muted">
                Submitted by @Model.TeacherName on @(Model.SubmittedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Recently"). All fields are locked against further changes. If you need corrections, please contact the Controller of Examinations Office.
            </div>
        </div>
        <span class="badge bg-warning text-dark px-3 py-2 fw-bold">PENDING VERIFICATION</span>
    </div>
}
else if (Model.Status == College_Web_Application.Models.ExamSubmissionStatus.ApprovedByController)
{
    <div class="alert alert-success border-success d-flex align-items-center shadow-sm p-3 mb-4 rounded-3">
        <i class="bi bi-patch-check-fill fs-3 text-success me-3"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-dark">Award List Officially Verified & Approved by Controller of Examinations</h6>
            <div class="small text-muted">
                Verified on @(Model.VerifiedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Recently"). Grades are permanently archived and compiled into the Official Master DMC.
            </div>
        </div>
        <span class="badge bg-success text-white px-3 py-2 fw-bold">PERMANENTLY LOCKED</span>
    </div>
}
else if (Model.Status == College_Web_Application.Models.ExamSubmissionStatus.ReturnedForCorrection)
{
    <div class="alert alert-danger border-danger d-flex align-items-center shadow-sm p-3 mb-4 rounded-3">
        <i class="bi bi-exclamation-octagon-fill fs-3 text-danger me-3"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-danger">Award List Returned for Correction by Controller of Examinations</h6>
            <div class="small text-dark fw-semibold">
                Controller Remarks: "@Model.ControllerRemarks"
            </div>
            <div class="small text-muted mt-1">
                Please make the necessary corrections below and click "Final Submit Award List" to return the updated record to the Controller of Examinations.
            </div>
        </div>
        <span class="badge bg-danger text-white px-3 py-2 fw-bold">CORRECTION REQUIRED</span>
    </div>
}
else
{
    <div class="alert alert-info border-info d-flex align-items-center shadow-sm p-3 mb-4 rounded-3">
        <i class="bi bi-info-circle-fill fs-3 text-primary me-3"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-dark">Draft Mode: Subject-Locked Grading Engine</h6>
            <div class="small text-muted">
                You can save your progress anytime with <strong>"Save as Draft"</strong>. Once all marks are complete and verified against your attendance sheet, click <strong>"Final Submit Award List to Controller of Exams"</strong> to lock and dispatch the record.
            </div>
        </div>
    </div>
}

<form asp-action="SaveOrSubmitMarks" method="post" id="gradingForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CourseId" />
    <input type="hidden" asp-for="Section" />
    <input type="hidden" asp-for="AcademicSession" />

    <div class="card card-portal shadow-sm mb-4">
        <div class="card-header-portal d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-success fs-5"></i>
                <span class="fw-bold">Official Award List Grid (Max 100 Marks)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (!Model.IsLocked)
                {
                    <button type="button" class="btn btn-outline-primary btn-sm fw-semibold shadow-xs" data-bs-toggle="modal" data-bs-target="#csvImportModal">
                        <i class="bi bi-filetype-csv me-1"></i> Import CSV Marks
                    </button>
                }
                <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" onclick="document.getElementById('analyticsSection').scrollIntoView({behavior:'smooth'})">
                    <i class="bi bi-bar-chart-fill me-1"></i> Class Analytics
                </button>
                <span class="badge bg-light text-secondary border">Mid: 30 Max</span>
                <span class="badge bg-light text-secondary border">Sessional: 20 Max</span>
                <span class="badge bg-light text-secondary border">Final: 50 Max</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" id="marksTable">
                    <thead class="table-light small text-uppercase text-muted text-center">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="text-start" style="min-width: 130px;">Roll Number</th>
                            <th class="text-start" style="min-width: 180px;">Student Name</th>
                            @if (Model.ProgramLevel == "BS")
                            {
                                <th style="width: 140px;">Attendance %<br><small class="text-muted">(Min 75% HEC)</small></th>
                            }
                            <th style="width: 105px;">Mid-Term<br><small class="text-muted">(Max 30)</small></th>
                            <th style="width: 105px;">Sessional<br><small class="text-muted">(Max 20)</small></th>
                            <th style="width: 125px;">Final Term<br><small class="text-muted">(Max 50)</small></th>
                            <th style="width: 95px;">Total<br><small class="text-muted">(100)</small></th>
                            <th style="width: 80px;">Grade</th>
                            <th style="width: 75px;">GP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.StudentMarks.Any())
                        {
                            for (int i = 0; i < Model.StudentMarks.Count; i++)
                            {
                                var item = Model.StudentMarks[i];
                                <tr class="@(item.IsDebarredForShortAttendance ? "table-danger bg-opacity-25" : "")">
                                    <td class="text-center text-muted fw-semibold">@(i + 1)</td>
                                    <td>
                                        <input type="hidden" name="StudentMarks[@i].StudentId" value="@item.StudentId" />
                                        <input type="hidden" name="StudentMarks[@i].RollNumber" value="@item.RollNumber" />
                                        <input type="hidden" name="StudentMarks[@i].FullName" value="@item.FullName" />
                                        <input type="hidden" name="StudentMarks[@i].AttendancePercentage" value="@item.AttendancePercentage" />
                                        <input type="hidden" name="StudentMarks[@i].IsDebarredForShortAttendance" value="@(item.IsDebarredForShortAttendance ? "true" : "false")" />
                                        <div class="fw-bold text-dark font-monospace">@item.RollNumber</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.FullName</div>
                                        <div class="text-muted small">S/O @item.FatherName</div>
                                        @if (item.AcademicStatus == College_Web_Application.Models.AcademicStatus.Rusticated_ParentRequired)
                                        {
                                            <span class="badge bg-danger text-white mt-1" style="font-size: 0.68rem;">
                                                <i class="bi bi-slash-circle me-1"></i> RUSTICATED (Attendance Pending)
                                            </span>
                                        }
                                        else if (item.IsDebarredForShortAttendance)
                                        {
                                            <span class="badge bg-danger text-white mt-1" style="font-size: 0.68rem;">
                                                <i class="bi bi-slash-circle-fill me-1"></i> 🚫 DEBARRED (&lt;75% Attendance)
                                            </span>
                                        }
                                    </td>
                                    @if (Model.ProgramLevel == "BS")
                                    {
                                        <td class="text-center">
                                            <span class="badge @item.AttendanceBadgeClass fw-bold px-2 py-1">
                                                @item.AttendanceStatusText
                                            </span>
                                            @if (item.IsCondoned)
                                            {
                                                <div class="text-success small fw-semibold mt-1" style="font-size: 0.68rem;">
                                                    <i class="bi bi-patch-check-fill"></i> Principal Condoned
                                                </div>
                                            }
                                        </td>
                                    }
                                    <td>
                                        <input type="number" 
                                               step="0.5" 
                                               min="0" 
                                               max="30" 
                                               class="form-control form-control-sm text-center fw-bold mark-input mid-marks" 
                                               name="StudentMarks[@i].MidTermMarks" 
                                               value="@item.MidTermMarks.ToString("0.##")" 
                                               @(Model.IsLocked ? "disabled readonly" : "") />
                                    </td>
                                    <td>
                                        <input type="number" 
                                               step="0.5" 
                                               min="0" 
                                               max="20" 
                                               class="form-control form-control-sm text-center fw-bold mark-input sessional-marks" 
                                               name="StudentMarks[@i].SessionalMarks" 
                                               value="@item.SessionalMarks.ToString("0.##")" 
                                               @(Model.IsLocked ? "disabled readonly" : "") />
                                    </td>
                                    <td>
                                        @if (item.IsDebarredForShortAttendance)
                                        {
                                            <div class="text-center">
                                                <input type="hidden" name="StudentMarks[@i].FinalMarks" class="final-marks" value="0" />
                                                <span class="badge bg-danger text-white py-1.5 px-2" style="font-size: 0.72rem;" title="Debarred from Final Term Exam due to <75% attendance">
                                                    <i class="bi bi-lock-fill me-1"></i> DEBARRED (0)
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <input type="number" 
                                                   step="0.5" 
                                                   min="0" 
                                                   max="50" 
                                                   class="form-control form-control-sm text-center fw-bold mark-input final-marks" 
                                                   name="StudentMarks[@i].FinalMarks" 
                                                   value="@item.FinalMarks.ToString("0.##")" 
                                                   @(Model.IsLocked ? "disabled readonly" : "") />
                                        }
                                    </td>
                                    <td class="text-center fw-bold fs-6 total-marks-cell text-dark">
                                        @item.TotalMarks.ToString("0.##")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge grade-badge @GetGradeBadgeClass(item.Grade)">
                                            @item.Grade
                                        </span>
                                    </td>
                                    <td class="text-center fw-semibold gp-cell text-muted">
                                        @item.GradePoints.ToString("0.00")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(Model.ProgramLevel == "BS" ? 10 : 9)" class="text-center py-5 text-muted">
                                    No students enrolled in Semester @Model.Semester, Section @Model.Section for this program.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (!Model.IsLocked)
        {
            <div class="card-footer bg-light p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                <div class="text-muted small">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    Grading follows HED KP & University of Swat policy: A (85%+ = 4.0), A- (80%+ = 3.67), B+ (75%+ = 3.33), B (70%+ = 3.0), C (55%+ = 2.0).
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" name="actionType" value="Draft" class="btn btn-outline-secondary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Save as Draft
                    </button>
                    <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" onclick="confirmSubmit()">
                        <i class="bi bi-send-check-fill me-1"></i> Final Submit Award List to Controller
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    <i class="bi bi-lock-fill text-warning me-1"></i> This document is read-only.
                </div>
                <a asp-action="Index" class="btn btn-secondary px-4">
                    Back to Workload
                </a>
            </div>
        }
    </div>
</form>

<!-- CLASS ANALYTICS & GRADE DISTRIBUTION -->
<div class="card card-portal shadow-sm mb-4" id="analyticsSection">
    <div class="card-header-portal d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-graph-up text-primary fs-5"></i>
            <span class="fw-bold">Class Analytics & Grade Distribution</span>
        </div>
        <span class="badge bg-light text-secondary border">Live Computed Metrics</span>
    </div>
    <div class="card-body p-4">
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="p-3 bg-light rounded-3 text-center border">
                    <div class="text-muted small fw-semibold text-uppercase">Class Average</div>
                    <div class="h3 fw-bold text-dark mb-0" id="classAvgStat">0.0</div>
                    <div class="small text-muted" style="font-size: 0.72rem;">Out of 100 Marks</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-light rounded-3 text-center border">
                    <div class="text-muted small fw-semibold text-uppercase">Highest Score</div>
                    <div class="h3 fw-bold text-success mb-0" id="highestScoreStat">0.0</div>
                    <div class="small text-muted" style="font-size: 0.72rem;">Class Topper</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-light rounded-3 text-center border">
                    <div class="text-muted small fw-semibold text-uppercase">Pass Rate</div>
                    <div class="h3 fw-bold text-primary mb-0" id="passRateStat">0%</div>
                    <div class="small text-muted" style="font-size: 0.72rem;">Passing &ge; 50 Marks</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3 bg-light rounded-3 text-center border">
                    <div class="text-muted small fw-semibold text-uppercase">Attendance Debarred</div>
                    <div class="h3 fw-bold text-danger mb-0" id="debarredCountStat">
                        @Model.StudentMarks.Count(s => s.IsDebarredForShortAttendance)
                    </div>
                    <div class="small text-danger fw-semibold" style="font-size: 0.72rem;">&lt; 75% Attendance</div>
                </div>
            </div>
        </div>

        <div class="border rounded-3 p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold text-dark mb-0 small text-uppercase">
                    <i class="bi bi-bar-chart-steps me-1 text-success"></i> Grade Frequency Bell Curve
                </h6>
                <span class="small text-muted">A (85+) &bull; B (70+) &bull; C (55+) &bull; D (50+) &bull; F (&lt;50)</span>
            </div>
            <div style="height: 240px; position: relative;">
                <canvas id="gradeDistributionChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- CSV Import Modal -->
<div class="modal fade" id="csvImportModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-filetype-csv me-2 text-warning"></i>Import Marks from Spreadsheet / CSV
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-3">
                    Paste your Excel or CSV data below or choose a .csv file. The parser matches each line by <strong>Roll Number</strong> and automatically sets Mid-Term, Sessional, and Final-Term marks.
                </p>

                <div class="alert alert-secondary small p-2.5 mb-3 font-monospace">
                    <strong>Expected CSV Header / Format:</strong><br />
                    <code>RollNumber,MidTerm,Sessional,FinalTerm</code><br />
                    <em>Example: GDCM-BSCS-26-001,25.5,18.0,42.5</em>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Upload CSV File:</label>
                    <input type="file" id="csvFileInput" accept=".csv,text/csv" class="form-control form-control-sm" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Or Paste CSV / Tab-Delimited Data Here:</label>
                    <textarea id="csvPasteArea" class="form-control font-monospace small" rows="6" placeholder="RollNumber,MidTerm,Sessional,FinalTerm&#10;GDCM-BSCS-26-001,24.5,17.0,43.0&#10;GDCM-BSCS-26-002,28.0,19.0,46.5"></textarea>
                </div>

                <div id="csvFeedback" class="small text-muted"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success fw-bold px-4" onclick="applyCsvMarks()">
                    <i class="bi bi-check2-circle me-1"></i> Apply Marks to Grid
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="submitConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-shield-check me-2"></i>Confirm Final Submission to Controller
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">
                    Are you sure you want to submit the final Award List for <strong>@Model.CourseCode: @Model.CourseTitle (Section @Model.Section)</strong>?
                </p>
                <div class="alert alert-warning small mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>
                    <strong>IMPORTANT:</strong> Once submitted, all marks become <strong>LOCKED (Read-Only)</strong> for the teacher and will be directly forwarded to the Controller of Examinations for official compilation into the Master DMC.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel & Review</button>
                <button type="button" class="btn btn-success fw-bold px-4" onclick="executeFinalSubmit()">
                    Yes, Submit & Lock Award List
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    public static string GetGradeBadgeClass(string grade)
    {
        return grade switch
        {
            "A" or "A-" => "bg-success text-white",
            "B+" or "B" or "B-" => "bg-primary text-white",
            "C+" or "C" => "bg-warning text-dark",
            "D" => "bg-secondary text-white",
            _ => "bg-danger text-white"
        };
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var gradeChart = null;

        function confirmSubmit() {
            var modal = new bootstrap.Modal(document.getElementById('submitConfirmModal'));
            modal.show();
        }

        function executeFinalSubmit() {
            var form = document.getElementById('gradingForm');
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'actionType';
            input.value = 'Submit';
            form.appendChild(input);
            form.submit();
        }

        function recalculateRow(row) {
            var midInput = row.querySelector('.mid-marks');
            var sessionalInput = row.querySelector('.sessional-marks');
            var finalInput = row.querySelector('.final-marks');

            var mid = parseFloat(midInput ? midInput.value : 0) || 0;
            var sessional = parseFloat(sessionalInput ? sessionalInput.value : 0) || 0;
            var final = parseFloat(finalInput ? finalInput.value : 0) || 0;

            if (mid > 30) { if (midInput) midInput.value = 30; mid = 30; }
            if (sessional > 20) { if (sessionalInput) sessionalInput.value = 20; sessional = 20; }
            if (final > 50) { if (finalInput) finalInput.value = 50; final = 50; }

            var total = mid + sessional + final;
            var totalCell = row.querySelector('.total-marks-cell');
            if (totalCell) totalCell.textContent = total.toFixed(1);

            var gradeData = getGradeAndGp(total);
            var badge = row.querySelector('.grade-badge');
            if (badge) {
                badge.textContent = gradeData.grade;
                badge.className = 'badge grade-badge ' + gradeData.badgeClass;
            }
            var gpCell = row.querySelector('.gp-cell');
            if (gpCell) gpCell.textContent = gradeData.gp.toFixed(2);
        }

        function updateAnalyticsAndChart() {
            var rows = Array.from(document.querySelectorAll('#marksTable tbody tr'));
            var totals = [];
            var gradeCounts = { 'A': 0, 'A-': 0, 'B+': 0, 'B': 0, 'B-': 0, 'C+': 0, 'C': 0, 'D': 0, 'F': 0 };

            rows.forEach(function (r) {
                var totalCell = r.querySelector('.total-marks-cell');
                var badge = r.querySelector('.grade-badge');
                if (totalCell && badge) {
                    var tot = parseFloat(totalCell.textContent) || 0;
                    totals.push(tot);
                    var g = badge.textContent.trim();
                    if (g.startsWith('SA')) g = 'F';
                    if (gradeCounts.hasOwnProperty(g)) {
                        gradeCounts[g]++;
                    } else {
                        gradeCounts['F']++;
                    }
                }
            });

            if (totals.length > 0) {
                var sum = totals.reduce((a, b) => a + b, 0);
                var avg = sum / totals.length;
                var max = Math.max(...totals);
                var passCount = totals.filter(t => t >= 50).length;
                var passRate = (passCount / totals.length) * 100;

                var avgEl = document.getElementById('classAvgStat');
                var maxEl = document.getElementById('highestScoreStat');
                var passEl = document.getElementById('passRateStat');

                if (avgEl) avgEl.textContent = avg.toFixed(1);
                if (maxEl) maxEl.textContent = max.toFixed(1);
                if (passEl) passEl.textContent = passRate.toFixed(0) + '%';
            }

            // Update Chart.js
            var ctx = document.getElementById('gradeDistributionChart');
            if (ctx) {
                var labels = ['A (85+)', 'A- (80+)', 'B+ (75+)', 'B (70+)', 'B- (65+)', 'C+ (60+)', 'C (55+)', 'D (50+)', 'F (<50)'];
                var data = [
                    gradeCounts['A'], gradeCounts['A-'], gradeCounts['B+'],
                    gradeCounts['B'], gradeCounts['B-'], gradeCounts['C+'],
                    gradeCounts['C'], gradeCounts['D'], gradeCounts['F']
                ];

                if (gradeChart) {
                    gradeChart.data.datasets[0].data = data;
                    gradeChart.update();
                } else {
                    gradeChart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Student Count',
                                data: data,
                                backgroundColor: [
                                    '#0B6623', '#16A34A', '#2563EB', '#3B82F6', '#60A5FA',
                                    '#D97706', '#F59E0B', '#64748B', '#DC2626'
                                ],
                                borderRadius: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: { stepSize: 1 }
                                }
                            }
                        }
                    });
                }
            }
        }

        // CSV Import Handler
        function applyCsvMarks() {
            var text = document.getElementById('csvPasteArea').value;
            if (!text.trim()) {
                var feedback = document.getElementById('csvFeedback');
                if (feedback) feedback.innerHTML = '<span class="text-danger">Please paste CSV content or choose a file first.</span>';
                return;
            }

            var lines = text.split(/\r?\n/);
            var updatedCount = 0;
            var rows = Array.from(document.querySelectorAll('#marksTable tbody tr'));

            lines.forEach(function (line) {
                line = line.trim();
                if (!line) return;

                // Split by comma or tab
                var parts = line.split(/[,\t]/).map(p => p.trim());
                if (parts.length < 4) return;

                var rollNo = parts[0];
                var mid = parseFloat(parts[1]);
                var sessional = parseFloat(parts[2]);
                var final = parseFloat(parts[3]);

                if (isNaN(mid)) return; // Header row skipped

                // Find matching row
                var matchRow = rows.find(function (r) {
                    var rText = r.querySelector('.font-monospace')?.textContent.trim();
                    return rText && rText.toLowerCase() === rollNo.toLowerCase();
                });

                if (matchRow) {
                    var midInput = matchRow.querySelector('.mid-marks');
                    var sessionalInput = matchRow.querySelector('.sessional-marks');
                    var finalInput = matchRow.querySelector('.final-marks');

                    if (midInput && !midInput.readOnly) midInput.value = isNaN(mid) ? 0 : mid;
                    if (sessionalInput && !sessionalInput.readOnly) sessionalInput.value = isNaN(sessional) ? 0 : sessional;
                    if (finalInput && !finalInput.readOnly) finalInput.value = isNaN(final) ? 0 : final;

                    recalculateRow(matchRow);
                    updatedCount++;
                }
            });

            updateAnalyticsAndChart();

            var modalEl = document.getElementById('csvImportModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            alert('Successfully populated marks for ' + updatedCount + ' student(s) from CSV!');
        }

        // File upload reader
        var fileInput = document.getElementById('csvFileInput');
        if (fileInput) {
            fileInput.addEventListener('change', function (e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (evt) {
                        document.getElementById('csvPasteArea').value = evt.target.result;
                    };
                    reader.readAsText(file);
                }
            });
        }

        // Live calculation of Total Marks, Grade, and GP
        document.querySelectorAll('.mark-input').forEach(function (input) {
            input.addEventListener('input', function () {
                recalculateRow(this.closest('tr'));
                updateAnalyticsAndChart();
            });
        });

        function getGradeAndGp(total) {
            if (total >= 85) return { grade: "A", gp: 4.00, badgeClass: "bg-success text-white" };
            if (total >= 80) return { grade: "A-", gp: 3.67, badgeClass: "bg-success text-white" };
            if (total >= 75) return { grade: "B+", gp: 3.33, badgeClass: "bg-primary text-white" };
            if (total >= 70) return { grade: "B", gp: 3.00, badgeClass: "bg-primary text-white" };
            if (total >= 65) return { grade: "B-", gp: 2.67, badgeClass: "bg-primary text-white" };
            if (total >= 60) return { grade: "C+", gp: 2.33, badgeClass: "bg-warning text-dark" };
            if (total >= 55) return { grade: "C", gp: 2.00, badgeClass: "bg-warning text-dark" };
            if (total >= 50) return { grade: "D", gp: 1.00, badgeClass: "bg-secondary text-white" };
            return { grade: "F", gp: 0.00, badgeClass: "bg-danger text-white" };
        }

        document.addEventListener('DOMContentLoaded', function () {
            updateAnalyticsAndChart();
        });
    </script>
}
