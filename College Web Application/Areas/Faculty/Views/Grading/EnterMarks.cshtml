@model College_Web_Application.Models.ViewModels.EnterMarksViewModel
@{
    ViewData["Title"] = $"Enter Marks - {Model.CourseCode} ({Model.CourseTitle})";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Assigned Subjects</a></li>
                <li class="breadcrumb-item active">@Model.CourseCode - Award List</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-dark mb-1">
            @Model.CourseCode: @Model.CourseTitle
        </h4>
        <div class="text-muted small">
            Program: <strong>@Model.ProgramTitle</strong> | Semester: <strong>@Model.Semester</strong> | Section: <strong>@Model.Section</strong> | Session: <strong>@Model.AcademicSession</strong> | Cr.Hrs: <strong>@Model.CreditHours</strong>
        </div>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Workload
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- STATUS BANNER & WORKFLOW LOCK STATE -->
@if (Model.Status == College_Web_Application.Models.ExamSubmissionStatus.SubmittedToController)
{
    <div class="alert alert-warning border-warning d-flex align-items-center shadow-sm p-3 mb-4 rounded-3">
        <i class="bi bi-lock-fill fs-3 text-warning me-3"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-dark">Award List Submitted to Controller of Examinations (LOCKED)</h6>
            <div class="small text-muted">
                Submitted by @Model.TeacherName on @(Model.SubmittedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Recently"). All fields are locked against further changes. If you need corrections, please contact the Controller of Examinations Office.
            </div>
        </div>
        <span class="badge bg-warning text-dark px-3 py-2 fw-bold">PENDING VERIFICATION</span>
    </div>
}
else if (Model.Status == College_Web_Application.Models.ExamSubmissionStatus.ApprovedByController)
{
    <div class="alert alert-success border-success d-flex align-items-center shadow-sm p-3 mb-4 rounded-3">
        <i class="bi bi-patch-check-fill fs-3 text-success me-3"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-dark">Award List Officially Verified & Approved by Controller of Examinations</h6>
            <div class="small text-muted">
                Verified on @(Model.VerifiedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Recently"). Grades are permanently archived and compiled into the Official Master DMC.
            </div>
        </div>
        <span class="badge bg-success text-white px-3 py-2 fw-bold">PERMANENTLY LOCKED</span>
    </div>
}
else if (Model.Status == College_Web_Application.Models.ExamSubmissionStatus.ReturnedForCorrection)
{
    <div class="alert alert-danger border-danger d-flex align-items-center shadow-sm p-3 mb-4 rounded-3">
        <i class="bi bi-exclamation-octagon-fill fs-3 text-danger me-3"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-danger">Award List Returned for Correction by Controller of Examinations</h6>
            <div class="small text-dark fw-semibold">
                Controller Remarks: "@Model.ControllerRemarks"
            </div>
            <div class="small text-muted mt-1">
                Please make the necessary corrections below and click "Final Submit Award List" to return the updated record to the Controller of Examinations.
            </div>
        </div>
        <span class="badge bg-danger text-white px-3 py-2 fw-bold">CORRECTION REQUIRED</span>
    </div>
}
else
{
    <div class="alert alert-info border-info d-flex align-items-center shadow-sm p-3 mb-4 rounded-3">
        <i class="bi bi-info-circle-fill fs-3 text-primary me-3"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-dark">Draft Mode: Subject-Locked Grading Engine</h6>
            <div class="small text-muted">
                You can save your progress anytime with <strong>"Save as Draft"</strong>. Once all marks are complete and verified against your attendance sheet, click <strong>"Final Submit Award List to Controller of Exams"</strong> to lock and dispatch the record.
            </div>
        </div>
    </div>
}

<form asp-action="SaveOrSubmitMarks" method="post" id="gradingForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CourseId" />
    <input type="hidden" asp-for="Section" />
    <input type="hidden" asp-for="AcademicSession" />

    <div class="card card-portal shadow-sm mb-4">
        <div class="card-header-portal">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-success fs-5"></i>
                <span>Official Award List Grid (Max 100 Marks)</span>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-light text-secondary border">Mid: 30 Max</span>
                <span class="badge bg-light text-secondary border">Sessional: 20 Max</span>
                <span class="badge bg-light text-secondary border">Final: 50 Max</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" id="marksTable">
                    <thead class="table-light small text-uppercase text-muted text-center">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th class="text-start" style="min-width: 130px;">Roll Number</th>
                            <th class="text-start" style="min-width: 180px;">Student Name</th>
                            @if (Model.ProgramLevel == "BS")
                            {
                                <th style="width: 140px;">Attendance %<br><small class="text-muted">(Min 75% HEC)</small></th>
                            }
                            <th style="width: 105px;">Mid-Term<br><small class="text-muted">(Max 30)</small></th>
                            <th style="width: 105px;">Sessional<br><small class="text-muted">(Max 20)</small></th>
                            <th style="width: 125px;">Final Term<br><small class="text-muted">(Max 50)</small></th>
                            <th style="width: 95px;">Total<br><small class="text-muted">(100)</small></th>
                            <th style="width: 80px;">Grade</th>
                            <th style="width: 75px;">GP</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.StudentMarks.Any())
                        {
                            for (int i = 0; i < Model.StudentMarks.Count; i++)
                            {
                                var item = Model.StudentMarks[i];
                                <tr class="@(item.IsDebarredForShortAttendance ? "table-danger bg-opacity-25" : "")">
                                    <td class="text-center text-muted fw-semibold">@(i + 1)</td>
                                    <td>
                                        <input type="hidden" name="StudentMarks[@i].StudentId" value="@item.StudentId" />
                                        <input type="hidden" name="StudentMarks[@i].RollNumber" value="@item.RollNumber" />
                                        <input type="hidden" name="StudentMarks[@i].FullName" value="@item.FullName" />
                                        <input type="hidden" name="StudentMarks[@i].AttendancePercentage" value="@item.AttendancePercentage" />
                                        <input type="hidden" name="StudentMarks[@i].IsDebarredForShortAttendance" value="@(item.IsDebarredForShortAttendance ? "true" : "false")" />
                                        <div class="fw-bold text-dark font-monospace">@item.RollNumber</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.FullName</div>
                                        <div class="text-muted small">S/O @item.FatherName</div>
                                        @if (item.AcademicStatus == College_Web_Application.Models.AcademicStatus.Rusticated_ParentRequired)
                                        {
                                            <span class="badge bg-danger text-white mt-1" style="font-size: 0.68rem;">
                                                <i class="bi bi-slash-circle me-1"></i> RUSTICATED (Attendance Pending)
                                            </span>
                                        }
                                        else if (item.IsDebarredForShortAttendance)
                                        {
                                            <span class="badge bg-danger text-white mt-1" style="font-size: 0.68rem;">
                                                <i class="bi bi-slash-circle-fill me-1"></i> 🚫 DEBARRED (&lt;75% Attendance)
                                            </span>
                                        }
                                    </td>
                                    @if (Model.ProgramLevel == "BS")
                                    {
                                        <td class="text-center">
                                            <span class="badge @item.AttendanceBadgeClass fw-bold px-2 py-1">
                                                @item.AttendanceStatusText
                                            </span>
                                            @if (item.IsCondoned)
                                            {
                                                <div class="text-success small fw-semibold mt-1" style="font-size: 0.68rem;">
                                                    <i class="bi bi-patch-check-fill"></i> Principal Condoned
                                                </div>
                                            }
                                        </td>
                                    }
                                    <td>
                                        <input type="number" 
                                               step="0.5" 
                                               min="0" 
                                               max="30" 
                                               class="form-control form-control-sm text-center fw-bold mark-input mid-marks" 
                                               name="StudentMarks[@i].MidTermMarks" 
                                               value="@item.MidTermMarks.ToString("0.##")" 
                                               @(Model.IsLocked ? "disabled readonly" : "") />
                                    </td>
                                    <td>
                                        <input type="number" 
                                               step="0.5" 
                                               min="0" 
                                               max="20" 
                                               class="form-control form-control-sm text-center fw-bold mark-input sessional-marks" 
                                               name="StudentMarks[@i].SessionalMarks" 
                                               value="@item.SessionalMarks.ToString("0.##")" 
                                               @(Model.IsLocked ? "disabled readonly" : "") />
                                    </td>
                                    <td>
                                        @if (item.IsDebarredForShortAttendance)
                                        {
                                            <div class="text-center">
                                                <input type="hidden" name="StudentMarks[@i].FinalMarks" class="final-marks" value="0" />
                                                <span class="badge bg-danger text-white py-1.5 px-2" style="font-size: 0.72rem;" title="Debarred from Final Term Exam due to <75% attendance">
                                                    <i class="bi bi-lock-fill me-1"></i> DEBARRED (0)
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <input type="number" 
                                                   step="0.5" 
                                                   min="0" 
                                                   max="50" 
                                                   class="form-control form-control-sm text-center fw-bold mark-input final-marks" 
                                                   name="StudentMarks[@i].FinalMarks" 
                                                   value="@item.FinalMarks.ToString("0.##")" 
                                                   @(Model.IsLocked ? "disabled readonly" : "") />
                                        }
                                    </td>
                                    <td class="text-center fw-bold fs-6 total-marks-cell text-dark">
                                        @item.TotalMarks.ToString("0.##")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge grade-badge @GetGradeBadgeClass(item.Grade)">
                                            @item.Grade
                                        </span>
                                    </td>
                                    <td class="text-center fw-semibold gp-cell text-muted">
                                        @item.GradePoints.ToString("0.00")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(Model.ProgramLevel == "BS" ? 10 : 9)" class="text-center py-5 text-muted">
                                    No students enrolled in Semester @Model.Semester, Section @Model.Section for this program.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (!Model.IsLocked)
        {
            <div class="card-footer bg-light p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                <div class="text-muted small">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    Grading follows HED KP & University of Swat policy: A (85%+ = 4.0), A- (80%+ = 3.67), B+ (75%+ = 3.33), B (70%+ = 3.0), C (55%+ = 2.0).
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" name="actionType" value="Draft" class="btn btn-outline-secondary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Save as Draft
                    </button>
                    <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" onclick="confirmSubmit()">
                        <i class="bi bi-send-check-fill me-1"></i> Final Submit Award List to Controller
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card-footer bg-light p-3 d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    <i class="bi bi-lock-fill text-warning me-1"></i> This document is read-only.
                </div>
                <a asp-action="Index" class="btn btn-secondary px-4">
                    Back to Workload
                </a>
            </div>
        }
    </div>
</form>

<!-- Confirmation Modal -->
<div class="modal fade" id="submitConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-shield-check me-2"></i>Confirm Final Submission to Controller
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">
                    Are you sure you want to submit the final Award List for <strong>@Model.CourseCode: @Model.CourseTitle (Section @Model.Section)</strong>?
                </p>
                <div class="alert alert-warning small mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>
                    <strong>IMPORTANT:</strong> Once submitted, all marks become <strong>LOCKED (Read-Only)</strong> for the teacher and will be directly forwarded to the Controller of Examinations for official compilation into the Master DMC.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel & Review</button>
                <button type="button" class="btn btn-success fw-bold px-4" onclick="executeFinalSubmit()">
                    Yes, Submit & Lock Award List
                </button>
            </div>
        </div>
    </div>
</div>

@functions {
    public static string GetGradeBadgeClass(string grade)
    {
        return grade switch
        {
            "A" or "A-" => "bg-success text-white",
            "B+" or "B" or "B-" => "bg-primary text-white",
            "C+" or "C" => "bg-warning text-dark",
            "D" => "bg-secondary text-white",
            _ => "bg-danger text-white"
        };
    }
}

@section Scripts {
    <script>
        function confirmSubmit() {
            var modal = new bootstrap.Modal(document.getElementById('submitConfirmModal'));
            modal.show();
        }

        function executeFinalSubmit() {
            var form = document.getElementById('gradingForm');
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'actionType';
            input.value = 'Submit';
            form.appendChild(input);
            form.submit();
        }

        // Live calculation of Total Marks, Grade, and GP
        document.querySelectorAll('.mark-input').forEach(function (input) {
            input.addEventListener('input', function () {
                var row = this.closest('tr');
                var mid = parseFloat(row.querySelector('.mid-marks').value) || 0;
                var sessional = parseFloat(row.querySelector('.sessional-marks').value) || 0;
                var final = parseFloat(row.querySelector('.final-marks').value) || 0;

                // Clamp values
                if (mid > 30) { row.querySelector('.mid-marks').value = 30; mid = 30; }
                if (sessional > 20) { row.querySelector('.sessional-marks').value = 20; sessional = 20; }
                if (final > 50) { row.querySelector('.final-marks').value = 50; final = 50; }

                var total = mid + sessional + final;
                row.querySelector('.total-marks-cell').textContent = total.toFixed(1);

                var gradeData = getGradeAndGp(total);
                var badge = row.querySelector('.grade-badge');
                badge.textContent = gradeData.grade;
                badge.className = 'badge grade-badge ' + gradeData.badgeClass;
                row.querySelector('.gp-cell').textContent = gradeData.gp.toFixed(2);
            });
        });

        function getGradeAndGp(total) {
            if (total >= 85) return { grade: "A", gp: 4.00, badgeClass: "bg-success text-white" };
            if (total >= 80) return { grade: "A-", gp: 3.67, badgeClass: "bg-success text-white" };
            if (total >= 75) return { grade: "B+", gp: 3.33, badgeClass: "bg-primary text-white" };
            if (total >= 70) return { grade: "B", gp: 3.00, badgeClass: "bg-primary text-white" };
            if (total >= 65) return { grade: "B-", gp: 2.67, badgeClass: "bg-primary text-white" };
            if (total >= 60) return { grade: "C+", gp: 2.33, badgeClass: "bg-warning text-dark" };
            if (total >= 55) return { grade: "C", gp: 2.00, badgeClass: "bg-warning text-dark" };
            if (total >= 50) return { grade: "D", gp: 1.00, badgeClass: "bg-secondary text-white" };
            return { grade: "F", gp: 0.00, badgeClass: "bg-danger text-white" };
        }
    </script>
}
