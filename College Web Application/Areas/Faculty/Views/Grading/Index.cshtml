@model List<College_Web_Application.Models.ViewModels.AssignedCourseItemViewModel>
@{
    ViewData["Title"] = "My Assigned Subjects & Award Lists";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="bi bi-award-fill text-warning me-2"></i>My Assigned Subjects & Grading Portals
        </h4>
        <div class="text-muted small">
            Instructor: <strong>@ViewBag.TeacherName</strong> (@ViewBag.Designation) | Strict Subject-Assignment Security
        </div>
    </div>
    <div class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
        <i class="bi bi-shield-lock me-1"></i> Subject-Locked Grading Engine
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card card-portal shadow-sm">
    <div class="card-header-portal">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-journal-check text-success fs-5"></i>
            <span>Current Assigned Course Workload</span>
        </div>
        <span class="badge bg-light text-dark border">@Model.Count Assigned Courses</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase fw-bold text-muted">
                    <tr>
                        <th class="ps-4">Course Code & Title</th>
                        <th>Program & Level</th>
                        <th>Semester / Section</th>
                        <th>Session</th>
                        <th>Credit Hrs</th>
                        <th>Students</th>
                        <th>Award List Status</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.CourseCode</div>
                                    <div class="text-muted small">@item.CourseTitle</div>
                                </td>
                                <td>
                                    <span class="badge @(item.Level == "HSSC" ? "bg-info bg-opacity-15 text-info" : "bg-primary bg-opacity-15 text-primary") fw-semibold">
                                        @item.Level
                                    </span>
                                    <span class="small text-secondary ms-1">@item.ProgramTitle</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">Semester @item.Semester</span>
                                    <span class="badge bg-secondary bg-opacity-15 text-secondary">Sec @item.Section</span>
                                </td>
                                <td>
                                    <span class="small text-muted">@item.AcademicSession</span>
                                </td>
                                <td>
                                    <span class="fw-semibold">@item.CreditHours</span>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">@item.GradedCount / @item.EnrolledStudentsCount</div>
                                    <div class="progress" style="height: 4px; width: 60px;">
                                        @{
                                            var pct = item.EnrolledStudentsCount > 0 ? (item.GradedCount * 100 / item.EnrolledStudentsCount) : 0;
                                        }
                                        <div class="progress-bar bg-success" style="width: @pct%"></div>
                                    </div>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case College_Web_Application.Models.ExamSubmissionStatus.Draft:
                                            <span class="badge bg-secondary bg-opacity-15 text-secondary">
                                                <i class="bi bi-pencil me-1"></i> Draft (Editable)
                                            </span>
                                            break;
                                        case College_Web_Application.Models.ExamSubmissionStatus.SubmittedToController:
                                            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning border-opacity-50">
                                                <i class="bi bi-lock-fill me-1 text-warning"></i> Submitted to Controller
                                            </span>
                                            break;
                                        case College_Web_Application.Models.ExamSubmissionStatus.ApprovedByController:
                                            <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-50">
                                                <i class="bi bi-patch-check-fill me-1"></i> Verified & Approved
                                            </span>
                                            break;
                                        case College_Web_Application.Models.ExamSubmissionStatus.ReturnedForCorrection:
                                            <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-50" title="@item.ControllerRemarks">
                                                <i class="bi bi-arrow-return-left me-1"></i> Returned for Correction
                                            </span>
                                            break;
                                    }

                                    @if (!string.IsNullOrEmpty(item.ControllerRemarks))
                                    {
                                        <div class="text-danger small fst-italic mt-1" style="font-size: 0.75rem;">
                                            Note: @item.ControllerRemarks
                                        </div>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="EnterMarks" 
                                       asp-route-courseId="@item.CourseId" 
                                       asp-route-section="@item.Section" 
                                       asp-route-session="@item.AcademicSession"
                                       class="btn btn-sm @(item.IsLocked ? "btn-outline-secondary" : "btn-success") px-3">
                                        <i class="bi @(item.IsLocked ? "bi-eye" : "bi-pencil-square") me-1"></i>
                                        @(item.IsLocked ? "View Award List" : "Enter Marks")
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No subjects currently assigned. Please contact the Head of Department or Principal Office.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
