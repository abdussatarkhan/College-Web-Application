@model College_Web_Application.Models.ViewModels.AttendanceSummaryFilterViewModel
@{
    ViewData["Title"] = "College Attendance Register & Disciplinary Summary";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3 no-print">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Discipline Office</a></li>
                <li class="breadcrumb-item active">Attendance Register</li>
            </ol>
        </nav>
        <h4 class="fw-bold text-dark mb-1">
            <i class="bi bi-bar-chart-line-fill text-warning me-2"></i>Institutional Attendance & Compliance Register
        </h4>
        <div class="text-muted small">
            Government Degree College Madyan Swat | Class Presence %, Absence Streaks & Disciplinary Status
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-danger btn-sm rounded-pill px-3">
            <i class="bi bi-shield-exclamation me-1"></i> Rustication Watchlist
        </a>
        <button type="button" class="btn btn-dark btn-sm rounded-pill px-3" onclick="window.print()">
            <i class="bi bi-printer-fill me-1"></i> Print Register
        </button>
    </div>
</div>

<!-- FILTER BAR -->
<div class="card card-portal shadow-sm mb-4 no-print">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-12 col-md-6">
                <label class="form-label small fw-bold text-muted mb-1">Select Program</label>
                <select name="programId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var p in Model.Programs)
                    {
                        <option value="@p.Id" selected="@(p.Id == Model.SelectedProgramId ? "selected" : null)">
                            [@p.Level] @p.Title
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold text-muted mb-1">Section</label>
                <select name="section" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="A" selected="@(Model.SelectedSection == "A" ? "selected" : null)">Section A</option>
                    <option value="B" selected="@(Model.SelectedSection == "B" ? "selected" : null)">Section B</option>
                    <option value="Morning" selected="@(Model.SelectedSection == "Morning" ? "selected" : null)">Morning Section</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-dark w-100">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card card-portal shadow-sm">
    <div class="card-header-portal">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-table text-success fs-5"></i>
            <span>Student Attendance Register</span>
        </div>
        <span class="badge bg-light text-dark border">@Model.Rows.Count Students</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-light small text-uppercase text-center text-muted fw-bold">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th class="text-start" style="min-width: 140px;">Roll Number</th>
                        <th class="text-start" style="min-width: 220px;">Student Name</th>
                        <th style="width: 90px;">Classes</th>
                        <th style="width: 90px;">Present</th>
                        <th style="width: 90px;">Absent</th>
                        <th style="width: 90px;">Leave</th>
                        <th style="width: 120px;">Attendance %</th>
                        <th style="width: 120px;">Absence Streak</th>
                        <th style="width: 150px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Any())
                    {
                        for (int i = 0; i < Model.Rows.Count; i++)
                        {
                            var r = Model.Rows[i];
                            var isLow = r.AttendancePercentage < 75.0m && r.TotalClassesHeld > 0;
                            var isRusticated = r.AcademicStatus == College_Web_Application.Models.AcademicStatus.Rusticated_ParentRequired;

                            <tr class="@(isRusticated ? "table-danger" : (isLow ? "table-warning bg-opacity-25" : ""))">
                                <td class="text-center text-muted fw-semibold">@(i + 1)</td>
                                <td class="fw-bold font-monospace text-dark">@r.RollNumber</td>
                                <td>
                                    <div class="fw-bold text-dark">@r.FullName</div>
                                    <div class="text-muted small">S/O @r.FatherName</div>
                                </td>
                                <td class="text-center fw-semibold">@r.TotalClassesHeld</td>
                                <td class="text-center text-success fw-bold">@r.TotalPresent</td>
                                <td class="text-center text-danger fw-bold">@r.TotalAbsent</td>
                                <td class="text-center text-warning fw-semibold">@r.TotalLeave</td>
                                <td class="text-center">
                                    <span class="fw-bold @(isLow ? "text-danger" : "text-success")">
                                        @r.AttendancePercentage.ToString("0.0")%
                                    </span>
                                    <div class="progress mt-1" style="height: 4px;">
                                        <div class="progress-bar @(isLow ? "bg-danger" : "bg-success")" style="width: @r.AttendancePercentage%"></div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (r.ConsecutiveAbsentStreak > 0)
                                    {
                                        <span class="badge @(r.ConsecutiveAbsentStreak >= 3 ? "bg-danger" : "bg-warning text-dark")">
                                            @r.ConsecutiveAbsentStreak Day@(r.ConsecutiveAbsentStreak > 1 ? "s" : "")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (isRusticated)
                                    {
                                        <span class="badge bg-danger text-white py-1.5 px-2">
                                            <i class="bi bi-slash-circle me-1"></i> RUSTICATED
                                        </span>
                                    }
                                    else if (isLow)
                                    {
                                        <span class="badge bg-warning text-dark py-1.5 px-2">
                                            <i class="bi bi-exclamation-triangle me-1"></i> SHORT ATTENDANCE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-20 text-success border border-success py-1.5 px-2">
                                            <i class="bi bi-check-circle me-1"></i> ELIGIBLE (75%+)
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                No student records found for this program and section.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
