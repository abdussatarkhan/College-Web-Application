@model College_Web_Application.Models.ViewModels.FeeChallanListViewModel
@{
    ViewData["Title"] = "Fee & Challan Management";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1.5 rounded-pill fw-semibold">
                    <i class="bi bi-bank2 me-1"></i> BoK / NBP Accounts Office
                </span>
                <span class="text-muted small">| Total Vouchers: @Model.TotalCount</span>
            </div>
            <h2 class="h3 fw-bold text-dark mt-2 mb-0">Fee & Challan Management</h2>
            <p class="text-muted small mb-0">Bulk generate 3-copy bank vouchers, record bank scroll deposits, and verify fee receipts.</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-success btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#verifyPaymentModal">
                <i class="bi bi-check-circle me-1"></i> Verify Paid Challan
            </button>
            <button type="button" class="btn btn-gdc-primary btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkGenerateModal">
                <i class="bi bi-plus-circle me-1"></i> Generate Bulk Challans
            </button>
        </div>
    </div>

    <!-- Filter Toolbar -->
    <div class="card card-portal mb-4 p-3 bg-white">
        <form asp-area="Admin" asp-controller="FeeChallans" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Challan #, Roll No, Student Name..." />
                </div>
            </div>

            <div class="col-6 col-md-3">
                <select name="programId" class="form-select form-select-sm">
                    <option value="">All Programs</option>
                    @foreach (var prog in Model.Programs)
                    {
                        <option value="@prog.Id" selected="@(Model.ProgramId == prog.Id)">@prog.Title</option>
                    }
                </select>
            </div>

            <div class="col-3 col-md-2">
                <select name="semester" class="form-select form-select-sm">
                    <option value="">All Semesters</option>
                    @for (int i = 1; i <= 8; i++)
                    {
                        <option value="@i" selected="@(Model.Semester == i)">Semester @i</option>
                    }
                </select>
            </div>

            <div class="col-3 col-md-2">
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="All" selected="@(Model.StatusFilter == "All")">All Status</option>
                    <option value="Paid" selected="@(Model.StatusFilter == "Paid")">Paid Only</option>
                    <option value="Unpaid" selected="@(Model.StatusFilter == "Unpaid")">Unpaid / Defaulters</option>
                </select>
            </div>

            <div class="col-12 col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-gdc-primary btn-sm w-100" title="Filter Records">
                    <i class="bi bi-funnel-fill"></i>
                </button>
                <a asp-area="Admin" asp-controller="FeeChallans" asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Challan Table -->
    <div class="card card-portal">
        <div class="card-header-portal">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-receipt-cutoff text-success"></i>
                <span>Issued Fee Challans (Bank of Khyber / NBP)</span>
            </div>
            <span class="badge bg-light text-secondary border">Showing @Model.Challans.Count of @Model.TotalCount</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 170px;">Challan Number</th>
                        <th>Student Name & Roll No</th>
                        <th>Program & Semester</th>
                        <th>Amount (PKR)</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Bank Scroll Ref</th>
                        <th class="text-end">Voucher</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Challans.Any())
                    {
                        foreach (var item in Model.Challans)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold font-monospace text-dark">@item.ChallanNumber</span>
                                    <div class="text-muted" style="font-size: 0.72rem;">Issued: @item.IssueDate.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Student?.FullName</div>
                                    <div class="text-success small font-monospace">@item.Student?.RollNumber</div>
                                </td>
                                <td>
                                    <div>@item.Student?.Program?.Title</div>
                                    <span class="badge bg-light text-secondary border">Semester @item.Semester</span>
                                </td>
                                <td class="fw-bold text-dark">
                                    PKR @item.TotalAmount.ToString("N0")
                                </td>
                                <td>
                                    <span class="@(item.DueDate < DateTime.UtcNow && !item.IsPaid ? "text-danger fw-semibold" : "text-muted")">
                                        @item.DueDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsPaid)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                            <i class="bi bi-check2-circle me-1"></i> Paid
                                        </span>
                                        <div class="text-muted" style="font-size: 0.7rem;">@item.PaidDate?.ToString("dd MMM yyyy")</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                            <i class="bi bi-clock-history me-1"></i> Unpaid
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.BankReference))
                                    {
                                        <span class="badge bg-light text-dark border">@item.BankReference</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="FeeChallans" asp-action="PrintChallan" asp-route-id="@item.Id" target="_blank"
                                       class="btn btn-outline-success btn-sm" title="Print 3-Copy Bank Voucher">
                                        <i class="bi bi-printer-fill me-1"></i> Print
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-receipt fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No fee challans found matching current filters.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div class="text-muted small">
                    Page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (Total @Model.TotalCount items)
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-searchQuery="@Model.SearchQuery" 
                               asp-route-programId="@Model.ProgramId" 
                               asp-route-semester="@Model.Semester" 
                               asp-route-statusFilter="@Model.StatusFilter">
                                Previous
                            </a>
                        </li>
                        
                        @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@p" 
                                   asp-route-searchQuery="@Model.SearchQuery" 
                                   asp-route-programId="@Model.ProgramId" 
                                   asp-route-semester="@Model.Semester" 
                                   asp-route-statusFilter="@Model.StatusFilter">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-searchQuery="@Model.SearchQuery" 
                               asp-route-programId="@Model.ProgramId" 
                               asp-route-semester="@Model.Semester" 
                               asp-route-statusFilter="@Model.StatusFilter">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal: Bulk Generate Challans -->
<div class="modal fade" id="bulkGenerateModal" tabindex="-1" aria-labelledby="bulkGenerateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-area="Admin" asp-controller="FeeChallans" asp-action="GenerateBulkChallans" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="bulkGenerateModalLabel">
                        <i class="bi bi-plus-circle me-1"></i> Bulk Generate Bank Challans
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Academic Program</label>
                        <select name="ProgramId" class="form-select" required>
                            <option value="">-- Choose Program --</option>
                            @foreach (var prog in Model.Programs)
                            {
                                <option value="@prog.Id">@prog.Title (@prog.Level)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Semester</label>
                            <select name="Semester" class="form-select" required>
                                @for (int i = 1; i <= 8; i++)
                                {
                                    <option value="@i">Semester @i</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Due Date</label>
                            <input type="date" name="DueDate" value="@DateTime.UtcNow.AddDays(20).ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small">Tuition Fee (PKR)</label>
                            <input type="number" step="100" name="TuitionFee" value="4500" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Exam Fee (PKR)</label>
                            <input type="number" step="100" name="ExamFee" value="1500" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Admission Fee</label>
                            <input type="number" step="100" name="AdmissionFee" value="0" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Library Fund</label>
                            <input type="number" step="100" name="LibraryFund" value="500" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Lab Fund</label>
                            <input type="number" step="100" name="LabFund" value="500" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gdc-primary btn-sm">Generate Vouchers</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Verify Paid Challan -->
<div class="modal fade" id="verifyPaymentModal" tabindex="-1" aria-labelledby="verifyPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-area="Admin" asp-controller="FeeChallans" asp-action="MarkAsPaid" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="verifyPaymentModalLabel">
                        <i class="bi bi-check-circle me-1"></i> Verify Paid Challan
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Challan Number</label>
                        <input type="text" name="ChallanNumber" class="form-control font-monospace" placeholder="e.g. BOK-GDCM-2026-1002" required />
                        <small class="text-muted">Enter or scan barcode from bank deposit receipt.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Bank Scroll / Reference Number</label>
                        <input type="text" name="BankReference" class="form-control" placeholder="e.g. BOK-MDY-DEP-9941" required />
                        <small class="text-muted">From Bank of Khyber or NBP daily collection scroll.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Payment Deposit Date</label>
                        <input type="date" name="PaidDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm">Confirm Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>
