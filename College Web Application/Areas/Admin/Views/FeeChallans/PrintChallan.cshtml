@model College_Web_Application.Models.FeeChallan
@{
    ViewData["Title"] = $"Fee Challan - {Model.ChallanNumber}";
    Layout = null; // Standalone printable template
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fee Voucher - @Model.ChallanNumber - GDC Madyan Swat</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Libre+Barcode+39+Text&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            margin: 0;
            padding: 15px;
            font-size: 11px;
        }

        .arabic-motto {
            font-family: 'Amiri', serif;
            font-size: 13px;
        }

        .barcode-font {
            font-family: 'Libre Barcode 39 Text', cursive;
            font-size: 26px;
            letter-spacing: 2px;
        }

        /* 3-Column Perforated Voucher Container */
        .voucher-sheet {
            background: #ffffff;
            max-width: 1200px;
            margin: 0 auto;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-radius: 6px;
            overflow: hidden;
        }

        .voucher-column {
            padding: 14px;
            position: relative;
        }

        .voucher-column:not(:last-child) {
            border-right: 2px dashed #94a3b8;
        }

        .copy-pill {
            display: inline-block;
            background: #0B6623;
            color: #ffffff;
            font-weight: 700;
            font-size: 10px;
            text-transform: uppercase;
            padding: 3px 10px;
            border-radius: 4px;
            letter-spacing: 0.8px;
        }

        .bank-info-box {
            background-color: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            padding: 6px 8px;
            margin-bottom: 8px;
            font-size: 10px;
        }

        .table-fee {
            width: 100%;
            margin-bottom: 8px;
            font-size: 10.5px;
            border-collapse: collapse;
        }

        .table-fee th, .table-fee td {
            border: 1px solid #cbd5e1;
            padding: 3px 6px;
        }

        .table-fee th {
            background-color: #f1f5f9;
            font-weight: 700;
        }

        .signature-line {
            border-top: 1px solid #64748b;
            margin-top: 25px;
            padding-top: 3px;
            font-size: 9.5px;
            text-align: center;
        }

        /* Screen Control Bar */
        .print-controls {
            max-width: 1200px;
            margin: 0 auto 15px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        @@media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
            }
            .print-controls {
                display: none !important;
            }
            .voucher-sheet {
                box-shadow: none !important;
                border: none !important;
                max-width: 100% !important;
                width: 100% !important;
            }
            .voucher-column {
                padding: 10px !important;
            }
            @@page {
                size: A4 landscape;
                margin: 5mm;
            }
        }
    </style>
</head>
<body>

    <!-- On-Screen Action Bar -->
    <div class="print-controls">
        <div>
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm me-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Portal
            </a>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 py-2 px-3">
                <i class="bi bi-check-circle me-1"></i> Official BoK / NBP 3-Copy Bank Voucher
            </span>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-success btn-sm fw-semibold shadow-sm">
                <i class="bi bi-printer-fill me-1"></i> Print 3-Copy Voucher (A4 Landscape)
            </button>
        </div>
    </div>

    <!-- 3-Copy Perforated Container -->
    <div class="voucher-sheet">
        <div class="row g-0">
            @for (int copy = 1; copy <= 3; copy++)
            {
                string copyName = copy == 1 ? "1. Bank Copy" : copy == 2 ? "2. College Copy" : "3. Student Copy";
                string copyRecipient = copy == 1 ? "To be retained by BoK / NBP" : copy == 2 ? "To be deposited at College Accounts" : "To be retained by Student";

                <div class="col-4 voucher-column">
                    <!-- Header -->
                    <div class="text-center border-bottom pb-2 mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="copy-pill">@copyName</span>
                            <span class="arabic-motto text-success fw-bold">رَبِّ زِدْنِي عِلْماً</span>
                        </div>
                        <h6 class="fw-bold mb-0 text-success" style="font-size: 11.5px; letter-spacing: 0.3px;">
                            GOVERNMENT DEGREE COLLEGE MADYAN SWAT
                        </h6>
                        <div class="text-muted" style="font-size: 9px;">
                            Higher Education Department, Khyber Pakhtunkhwa | Est. 2006
                        </div>
                    </div>

                    <!-- Bank Details Box -->
                    <div class="bank-info-box">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-dark">THE BANK OF KHYBER (BoK) / NBP</strong>
                            <span class="badge bg-light text-secondary border">Madyan Branch</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>A/C Title:</span>
                            <strong class="text-dark">Principal GDC Madyan Swat</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Account No:</span>
                            <span class="font-monospace fw-bold text-success">0142-2005481230-01</span>
                        </div>
                    </div>

                    <!-- Voucher Meta -->
                    <div class="d-flex justify-content-between align-items-center mb-2 px-1" style="font-size: 10px;">
                        <div>
                            <span>Challan No: </span>
                            <strong class="font-monospace text-dark">@Model.ChallanNumber</strong>
                        </div>
                        <div class="text-end">
                            <span>Due Date: </span>
                            <strong class="text-danger">@Model.DueDate.ToString("dd-MM-yyyy")</strong>
                        </div>
                    </div>

                    <!-- Student Particulars -->
                    <div class="bg-light p-2 rounded border mb-2" style="font-size: 10px;">
                        <div class="row g-1">
                            <div class="col-7">
                                <span>Name: </span><strong class="text-dark">@Model.Student?.FullName</strong>
                            </div>
                            <div class="col-5 text-end">
                                <span>Roll No: </span><strong class="text-success font-monospace">@Model.Student?.RollNumber</strong>
                            </div>
                            <div class="col-7">
                                <span>Father: </span><span>@Model.Student?.FatherName</span>
                            </div>
                            <div class="col-5 text-end">
                                <span>CNIC: </span><span class="font-monospace">@Model.Student?.CNIC</span>
                            </div>
                            <div class="col-8">
                                <span>Prog: </span><strong>@Model.Student?.Program?.Title</strong>
                            </div>
                            <div class="col-4 text-end">
                                <span>Sem: </span><strong>@(Model.Semester) (@(Model.Student?.Section ?? "A"))</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Itemized Fee Structure -->
                    <table class="table-fee">
                        <thead>
                            <tr>
                                <th>Fee Particulars</th>
                                <th class="text-end" style="width: 75px;">Amount (PKR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Semester Tuition Fee</td>
                                <td class="text-end">@Model.TuitionFee.ToString("N0")</td>
                            </tr>
                            @if (Model.AdmissionFee > 0)
                            {
                                <tr>
                                    <td>Admission / Registration Fee</td>
                                    <td class="text-end">@Model.AdmissionFee.ToString("N0")</td>
                                </tr>
                            }
                            <tr>
                                <td>College Examination Fund</td>
                                <td class="text-end">@Model.ExamFee.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td>Library / Digital Resource Fund</td>
                                <td class="text-end">@Model.LibraryFund.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td>Science & Computer Lab Fund</td>
                                <td class="text-end">@Model.LabFund.ToString("N0")</td>
                            </tr>
                            <tr class="table-light fw-bold">
                                <td>Total Payable (Within Due Date)</td>
                                <td class="text-end text-success">PKR @Model.TotalAmount.ToString("N0")</td>
                            </tr>
                            <tr style="font-size: 9.5px;" class="text-muted">
                                <td>Late Fee (After Due Date)</td>
                                <td class="text-end text-danger">+@Model.LateFine.ToString("N0")</td>
                            </tr>
                            <tr class="fw-bold">
                                <td>Total Payable (After Due Date)</td>
                                <td class="text-end text-danger">PKR @((Model.TotalAmount + Model.LateFine).ToString("N0"))</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mb-2" style="font-size: 9px;">
                        <em>Notice: @copyRecipient</em>
                    </div>

                    <!-- Signatures -->
                    <div class="row g-2 mt-4">
                        <div class="col-4">
                            <div class="signature-line">Candidate Sign</div>
                        </div>
                        <div class="col-4">
                            <div class="signature-line">Bank Cashier</div>
                        </div>
                        <div class="col-4">
                            <div class="signature-line">Officer / Stamp</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</body>
</html>
