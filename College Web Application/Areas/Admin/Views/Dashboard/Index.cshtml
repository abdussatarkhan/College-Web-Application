@model College_Web_Application.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Executive Analytics Dashboard";
}

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1.5 rounded-pill fw-semibold">
                    <i class="bi bi-building me-1"></i> GDC Madyan Swat
                </span>
                <span class="text-muted small">| Higher Education Department KP</span>
            </div>
            <h2 class="h3 fw-bold text-dark mt-2 mb-0">Executive Campus Dashboard</h2>
            <p class="text-muted small mb-0">Live institutional metrics, student enrollment, fee recovery & academic health.</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Admin" asp-controller="Students" asp-action="Index" class="btn btn-outline-success btn-sm shadow-sm">
                <i class="bi bi-people me-1"></i> Student Directory
            </a>
            <a asp-area="Admin" asp-controller="FeeChallans" asp-action="Index" class="btn btn-gdc-primary btn-sm shadow-sm">
                <i class="bi bi-receipt-cutoff me-1"></i> Challan Management
            </a>
            <a asp-area="Admin" asp-controller="AdmissionSettings" asp-action="Index" class="btn btn-warning btn-sm fw-bold shadow-sm text-dark">
                <i class="bi bi-toggles2 me-1"></i> Admission Controls
            </a>
        </div>
    </div>

    <!-- 4 KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- KPI 1: Total Students -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-portal h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Total Enrolled</span>
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-2">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </div>
                </div>
                <div class="h2 fw-bold text-dark mb-1">@Model.TotalStudents.ToString("N0")</div>
                <div class="d-flex align-items-center gap-2 mt-auto">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25" style="font-size: 0.72rem;">
                        BS 4-Year: @Model.BsStudentsCount
                    </span>
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" style="font-size: 0.72rem;">
                        HSSC: @Model.HsscStudentsCount
                    </span>
                </div>
            </div>
        </div>

        <!-- KPI 2: Faculty & Staff -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-portal h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Faculty & Staff</span>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2">
                        <i class="bi bi-person-workspace fs-5"></i>
                    </div>
                </div>
                <div class="h2 fw-bold text-dark mb-1">@Model.TotalFaculty</div>
                <div class="d-flex align-items-center gap-1 flex-wrap mt-auto">
                    @foreach (var grade in Model.StaffGradeBreakdown.Take(3))
                    {
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border" style="font-size: 0.7rem;">
                            @grade.Key: @grade.Value
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- KPI 3: Fee Collection Status -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-portal h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Fee Collection (PKR)</span>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                        <i class="bi bi-wallet2 fs-5"></i>
                    </div>
                </div>
                <div class="h2 fw-bold text-success mb-1">
                    PKR @((Model.TotalCollectedFee / 1000m).ToString("0.0"))k
                </div>
                <div class="small text-muted d-flex justify-content-between align-items-center mt-auto">
                    <span>Billed: PKR @Model.TotalBilledFee.ToString("N0")</span>
                    <span class="text-danger fw-semibold">Defaulters: @Model.DefaultersCount</span>
                </div>
            </div>
        </div>

        <!-- KPI 4: Attendance & Admissions -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-portal h-100 p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Campus Attendance</span>
                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-2">
                        <i class="bi bi-check2-circle fs-5"></i>
                    </div>
                </div>
                <div class="h2 fw-bold text-dark mb-1">@Model.TodayAttendancePercentage%</div>
                <div class="d-flex justify-content-between align-items-center mt-auto">
                    <span class="text-muted small">Daily Class Turnout</span>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25" style="font-size: 0.72rem;">
                        @Model.PendingApplicationsCount New Apps
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Chart 1: Department Enrollment -->
        <div class="col-12 col-lg-8">
            <div class="card card-portal h-100">
                <div class="card-header-portal">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-bar-chart-fill text-success"></i>
                        <span>Department-wise Student Enrollment</span>
                    </div>
                    <span class="badge bg-light text-secondary border">Academic Session 2026-27</span>
                </div>
                <div class="card-body p-3">
                    <div style="height: 300px; position: relative;">
                        <canvas id="enrollmentChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart 2: Fee Recovery Breakdown -->
        <div class="col-12 col-lg-4">
            <div class="card card-portal h-100">
                <div class="card-header-portal">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-pie-chart-fill text-warning"></i>
                        <span>Fee Recovery Status</span>
                    </div>
                    <span class="badge bg-light text-secondary border">BoK / NBP</span>
                </div>
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div style="height: 220px; position: relative;">
                        <canvas id="feeStatusChart"></canvas>
                    </div>
                    <div class="mt-3 pt-3 border-top d-flex justify-content-around text-center small">
                        <div>
                            <div class="text-muted">Collected</div>
                            <div class="fw-bold text-success">PKR @Model.TotalCollectedFee.ToString("N0")</div>
                        </div>
                        <div>
                            <div class="text-muted">Outstanding</div>
                            <div class="fw-bold text-danger">PKR @Model.DefaultersAmount.ToString("N0")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Administrative Actions Bar -->
    <div class="card card-portal mb-4 p-3 bg-light">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Action Hub</h6>
                <small class="text-muted">Common clerical & academic tasks</small>
            </div>
            <div class="col-12 col-md-9 d-flex flex-wrap gap-2 justify-content-md-end">
                <a asp-area="" asp-controller="Admissions" asp-action="MeritLists" class="btn btn-outline-success btn-sm bg-white">
                    <i class="bi bi-check2-square me-1"></i> Published Merit Lists
                </a>
                <a asp-area="Admin" asp-controller="Students" asp-action="Index" class="btn btn-outline-primary btn-sm bg-white">
                    <i class="bi bi-person-plus-fill me-1"></i> Add / Enroll Student
                </a>
                <a asp-area="Admin" asp-controller="FeeChallans" asp-action="Index" class="btn btn-outline-dark btn-sm bg-white">
                    <i class="bi bi-printer-fill me-1"></i> Generate Bulk Challans
                </a>
                <a asp-area="Admin" asp-controller="Students" asp-action="Index" class="btn btn-gdc-primary btn-sm">
                    <i class="bi bi-arrow-up-right-circle me-1"></i> Semester Batch Promotion
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Data Tables Row -->
    <div class="row g-4">
        <!-- Recent Admission Applications -->
        <div class="col-12 col-lg-6">
            <div class="card card-portal h-100">
                <div class="card-header-portal">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-person-fill text-primary"></i>
                        <span>Recent Online Applications</span>
                    </div>
                    <a asp-area="" asp-controller="Admissions" asp-action="MeritLists" class="btn btn-link btn-sm text-success p-0 text-decoration-none">
                        View All
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Tracking #</th>
                                <th>Applicant</th>
                                <th>Program</th>
                                <th>Merit %</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentApplications.Any())
                            {
                                foreach (var app in Model.RecentApplications)
                                {
                                    <tr>
                                        <td class="fw-semibold text-dark">@app.TrackingNumber</td>
                                        <td>
                                            <div class="fw-medium text-dark">@app.ApplicantName</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">@app.CNIC</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@app.AppliedProgram?.Title</span></td>
                                        <td class="fw-bold text-success">@app.MeritScore.ToString("0.00")%</td>
                                        <td>
                                            @if (app.Status == "MeritListed")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Merit Listed</span>
                                            }
                                            else if (app.Status == "Admitted")
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">Admitted</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">No applications found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Fee Challans Paid -->
        <div class="col-12 col-lg-6">
            <div class="card card-portal h-100">
                <div class="card-header-portal">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-cash-stack text-success"></i>
                        <span>Recent Bank Fee Payments (BoK / NBP)</span>
                    </div>
                    <a asp-area="Admin" asp-controller="FeeChallans" asp-action="Index" class="btn btn-link btn-sm text-success p-0 text-decoration-none">
                        View All
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Challan #</th>
                                <th>Student</th>
                                <th>Amount</th>
                                <th>Bank Reference</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentFeePayments.Any())
                            {
                                foreach (var fee in Model.RecentFeePayments)
                                {
                                    <tr>
                                        <td>
                                            <a asp-area="Admin" asp-controller="FeeChallans" asp-action="PrintChallan" asp-route-id="@fee.Id" target="_blank" class="fw-bold text-decoration-none text-success">
                                                @fee.ChallanNumber
                                            </a>
                                        </td>
                                        <td>
                                            <div class="fw-medium text-dark">@fee.Student?.FullName</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">@fee.Student?.RollNumber</div>
                                        </td>
                                        <td class="fw-bold text-dark">PKR @fee.TotalAmount.ToString("N0")</td>
                                        <td><span class="badge bg-light text-secondary border">@(fee.BankReference ?? "BoK Madyan")</span></td>
                                        <td class="text-muted small">@fee.PaidDate?.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">No recent payments recorded.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Department Enrollment Chart (Bar)
            const deptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentEnrollments.Select(d => d.DepartmentCode)));
            const deptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentEnrollments.Select(d => d.StudentCount)));

            const ctxEnrollment = document.getElementById('enrollmentChart').getContext('2d');
            new Chart(ctxEnrollment, {
                type: 'bar',
                data: {
                    labels: deptLabels.length > 0 ? deptLabels : ['CS', 'POL', 'ENG', 'ISL', 'URD', 'BIO', 'PHY-CHEM'],
                    datasets: [{
                        label: 'Enrolled Students',
                        data: deptData.length > 0 ? deptData : [120, 85, 95, 60, 45, 110, 75],
                        backgroundColor: '#0B6623',
                        borderRadius: 6,
                        hoverBackgroundColor: '#084C1A'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    }
                }
            });

            // Fee Status Chart (Doughnut)
            const collectedAmount = @Model.TotalCollectedFee;
            const outstandingAmount = @Model.DefaultersAmount;

            const ctxFee = document.getElementById('feeStatusChart').getContext('2d');
            new Chart(ctxFee, {
                type: 'doughnut',
                data: {
                    labels: ['Paid / Collected', 'Outstanding / Defaulter'],
                    datasets: [{
                        data: [collectedAmount > 0 ? collectedAmount : 75, outstandingAmount > 0 ? outstandingAmount : 25],
                        backgroundColor: ['#0B6623', '#EF4444'],
                        borderWidth: 2,
                        borderColor: '#FFFFFF'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                font: { size: 11 }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        });
    </script>
}
