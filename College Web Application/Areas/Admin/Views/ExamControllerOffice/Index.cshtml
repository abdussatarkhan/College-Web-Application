@model College_Web_Application.Models.ViewModels.ControllerDashboardViewModel
@{
    ViewData["Title"] = "Office of the Controller of Examinations";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold text-dark mb-1">
            <i class="bi bi-patch-check-fill text-warning me-2"></i>Controller of Examinations Office
        </h4>
        <div class="text-muted small">
            Government Degree College Madyan Swat | Examination Verification, Award List Lock & Master DMC Compilation
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ShortageList" asp-route-programId="@Model.SelectedProgramId" asp-route-semester="@Model.SelectedSemester" class="btn btn-outline-danger btn-sm px-3 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> BS 75% Attendance Shortage List
        </a>
        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill">
            <i class="bi bi-shield-check me-1"></i> Multi-Stage Verification Pipeline
        </span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-x-circle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- FILTER SELECTION BAR -->
<div class="card card-portal shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-12 col-md-5">
                <label class="form-label small fw-bold text-muted mb-1">Select Academic Program</label>
                <select name="programId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var p in Model.Programs)
                    {
                        <option value="@p.Id" selected="@(p.Id == Model.SelectedProgramId ? "selected" : null)">
                            [@p.Level] @p.Title
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold text-muted mb-1">Select Semester</label>
                <select name="semester" class="form-select form-select-sm" onchange="this.form.submit()">
                    @for (int sem = 1; sem <= 8; sem++)
                    {
                        <option value="@sem" selected="@(sem == Model.SelectedSemester ? "selected" : null)">
                            Semester @sem
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-dark w-100">
                    <i class="bi bi-filter me-1"></i> Load Workload Matrix
                </button>
            </div>
        </form>
    </div>
</div>

<!-- COURSE AWARD LIST STATUS MATRIX -->
<div class="card card-portal shadow-sm mb-4">
    <div class="card-header-portal">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-grid-3x3-gap-fill text-success fs-5"></i>
            <span>Semester @Model.SelectedSemester Award Lists Submission Matrix</span>
        </div>
        <div>
            @if (Model.AllCoursesApproved)
            {
                <span class="badge bg-success px-3 py-1.5 fw-bold">
                    <i class="bi bi-check-all me-1"></i> 100% Courses Verified & Ready for DMCs
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark px-3 py-1.5 fw-bold">
                    <i class="bi bi-clock-history me-1"></i> Pending Verification / Submission
                </span>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase fw-bold text-muted">
                    <tr>
                        <th class="ps-4">Course</th>
                        <th>Assigned Instructor</th>
                        <th>Section</th>
                        <th>Cr.Hrs</th>
                        <th>Graded Students</th>
                        <th>Workflow Status</th>
                        <th>Submitted At</th>
                        <th class="text-end pe-4">Controller Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.CourseStatuses.Any())
                    {
                        foreach (var c in Model.CourseStatuses)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@c.CourseCode</div>
                                    <div class="text-muted small">@c.Title</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@c.TeacherName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">Sec @c.Section</span>
                                </td>
                                <td>
                                    <span class="fw-semibold">@c.CreditHours</span>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">@c.GradedStudents / @c.TotalStudents</div>
                                </td>
                                <td>
                                    @switch (c.Status)
                                    {
                                        case College_Web_Application.Models.ExamSubmissionStatus.Draft:
                                            <span class="badge bg-secondary bg-opacity-20 text-secondary">
                                                <i class="bi bi-hourglass-split me-1"></i> Pending from Teacher
                                            </span>
                                            break;
                                        case College_Web_Application.Models.ExamSubmissionStatus.SubmittedToController:
                                            <span class="badge bg-warning text-dark border border-warning">
                                                <i class="bi bi-inbox-fill me-1"></i> Submitted to Controller (Pending Review)
                                            </span>
                                            break;
                                        case College_Web_Application.Models.ExamSubmissionStatus.ApprovedByController:
                                            <span class="badge bg-success bg-opacity-20 text-success border border-success">
                                                <i class="bi bi-check-circle-fill me-1"></i> Verified & Locked
                                            </span>
                                            break;
                                        case College_Web_Application.Models.ExamSubmissionStatus.ReturnedForCorrection:
                                            <span class="badge bg-danger bg-opacity-20 text-danger border border-danger">
                                                <i class="bi bi-arrow-return-left me-1"></i> Returned to Teacher
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">
                                        @(c.SubmittedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "—")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    @if (c.Status == College_Web_Application.Models.ExamSubmissionStatus.SubmittedToController)
                                    {
                                        <button type="button" 
                                                class="btn btn-sm btn-success fw-bold px-3 shadow-sm"
                                                onclick="openReviewModal(@c.CourseId, '@c.CourseCode', '@c.Title', @Model.SelectedSemester, @Model.SelectedProgramId)">
                                            <i class="bi bi-check2-circle me-1"></i> Review & Verify
                                        </button>
                                    }
                                    else if (c.Status == College_Web_Application.Models.ExamSubmissionStatus.ApprovedByController)
                                    {
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger px-2"
                                                title="Unlock and return for correction if teacher made a verified typo"
                                                onclick="openReturnModal(@c.CourseId, '@c.CourseCode', @Model.SelectedSemester, @Model.SelectedProgramId)">
                                            <i class="bi bi-unlock me-1"></i> Unlock
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Awaiting teacher</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                No courses configured for this program and semester.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- STUDENTS & MASTER DMC GENERATION -->
<div class="card card-portal shadow-sm">
    <div class="card-header-portal">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-mortarboard-fill text-success fs-5"></i>
            <span>Students Enrolled in Semester @Model.SelectedSemester (DMC Compilation)</span>
        </div>
        <span class="badge bg-light text-dark border">@Model.StudentsInSemester.Count Students</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase fw-bold text-muted">
                    <tr>
                        <th class="ps-4">Roll Number</th>
                        <th>Student Name & Father</th>
                        <th>Courses Approved</th>
                        <th>SGPA</th>
                        <th>Cumulative CGPA</th>
                        <th class="text-end pe-4">Official Document</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StudentsInSemester.Any())
                    {
                        foreach (var s in Model.StudentsInSemester)
                        {
                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-dark">
                                    @s.RollNumber
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@s.FullName</div>
                                    <div class="text-muted small">S/O @s.FatherName</div>
                                </td>
                                <td>
                                    <span class="badge @(s.CanGenerateDmc ? "bg-success" : "bg-warning text-dark")">
                                        @s.CompletedCoursesCount / @s.TotalSemesterCoursesCount Approved
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold fs-6 text-dark">@s.SGPA.ToString("0.00")</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-primary">@s.CGPA.ToString("0.00")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="GenerateSemesterDMC" 
                                       asp-route-studentId="@s.StudentId" 
                                       asp-route-semester="@Model.SelectedSemester"
                                       class="btn btn-sm @(s.CanGenerateDmc ? "btn-dark fw-bold" : "btn-outline-secondary") shadow-sm"
                                       target="_blank">
                                        <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>
                                        @(s.CanGenerateDmc ? "Generate Official Master DMC" : "View Provisional DMC")
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                No active students found in this semester.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Controller Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ReviewAwardList" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" id="modalCourseId" />
                <input type="hidden" name="semester" id="modalSemester" />
                <input type="hidden" name="programId" id="modalProgramId" />

                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-patch-check-fill text-warning me-2"></i>Verify & Approve Award List
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Course Details</label>
                        <div class="fw-bold text-dark fs-6" id="modalCourseTitle"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Select Controller Decision</label>
                        <select name="decision" id="modalDecision" class="form-select fw-semibold" onchange="toggleRemarksField(this.value)">
                            <option value="Approve">✅ Approve & Permanently Lock Award List</option>
                            <option value="Return">❌ Return to Teacher for Correction</option>
                        </select>
                    </div>

                    <div class="mb-3 d-none" id="remarksContainer">
                        <label class="form-label text-muted small fw-bold">Controller Correction Remarks (Displayed to Teacher)</label>
                        <textarea name="remarks" class="form-control" rows="3" placeholder="Specify error (e.g. Sessional marks exceeding 20, missing roll numbers, etc.)..."></textarea>
                    </div>

                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-shield-lock-fill me-1"></i>
                        Approving this award list updates student GPA/CGPAs across the college database and enables generation of the Official Detailed Marks Certificate (DMC).
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold px-4">Confirm & Execute</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openReviewModal(courseId, courseCode, title, semester, programId) {
            document.getElementById('modalCourseId').value = courseId;
            document.getElementById('modalSemester').value = semester;
            document.getElementById('modalProgramId').value = programId;
            document.getElementById('modalCourseTitle').textContent = courseCode + " - " + title;
            document.getElementById('modalDecision').value = "Approve";
            toggleRemarksField("Approve");

            var modal = new bootstrap.Modal(document.getElementById('reviewModal'));
            modal.show();
        }

        function openReturnModal(courseId, courseCode, semester, programId) {
            document.getElementById('modalCourseId').value = courseId;
            document.getElementById('modalSemester').value = semester;
            document.getElementById('modalProgramId').value = programId;
            document.getElementById('modalCourseTitle').textContent = courseCode + " (Unlock Request)";
            document.getElementById('modalDecision').value = "Return";
            toggleRemarksField("Return");

            var modal = new bootstrap.Modal(document.getElementById('reviewModal'));
            modal.show();
        }

        function toggleRemarksField(val) {
            var container = document.getElementById('remarksContainer');
            if (val === "Return") {
                container.classList.remove('d-none');
            } else {
                container.classList.add('d-none');
            }
        }
    </script>
}
