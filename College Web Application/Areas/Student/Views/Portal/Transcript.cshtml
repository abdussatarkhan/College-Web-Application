@model College_Web_Application.Models.ViewModels.StudentDmcViewModel
@{
    ViewData["Title"] = "Detailed Marks Certificate (DMC) - " + Model.Student.FullName;
}

<style>
    @@media print {
        .no-print, .portal-sidebar, .portal-topbar, .mobile-bottom-nav {
            display: none !important;
        }
        .portal-content {
            padding: 0 !important;
            margin: 0 !important;
        }
        .dmc-sheet {
            box-shadow: none !important;
            border: 2px solid #000 !important;
            margin: 0 auto !important;
            padding: 20px !important;
            width: 100% !important;
        }
        body {
            background: #fff !important;
            color: #000 !important;
        }
    }

    .dmc-sheet {
        background: #FFFFFF;
        border: 2px solid #0B6623;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        padding: 40px;
        max-width: 900px;
        margin: 0 auto;
        position: relative;
    }

    .dmc-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 380px;
        height: 380px;
        opacity: 0.05;
        pointer-events: none;
        z-index: 0;
    }
</style>

<div class="container py-3">
    <!-- Top Action Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">
                <i class="bi bi-printer-fill me-1"></i> Print / Save PDF
            </button>
        </div>
    </div>

    <!-- Official Printable DMC Sheet -->
    <div class="dmc-sheet position-relative">
        <img src="~/images/gdc-madyan-logo.png" alt="Watermark Crest" class="dmc-watermark" />

        <!-- Header with Crest & College Title -->
        <div class="text-center pb-3 border-bottom border-2 border-success mb-4 position-relative" style="z-index: 1;">
            <div class="d-flex justify-content-between align-items-center">
                <img src="~/images/gdc-madyan-logo.png" alt="GDC Madyan Crest" style="width: 75px; height: 75px; object-fit: contain;" />
                <div class="flex-grow-1 mx-3">
                    <div class="arabic-motto text-success fw-bold fs-5 mb-1">رَبِّ زِدْنِي عِلْماً</div>
                    <h3 class="fw-bold mb-0 text-dark" style="letter-spacing: -0.5px;">GOVERNMENT DEGREE COLLEGE MADYAN SWAT</h3>
                    <div class="text-secondary small fw-semibold">Higher Education Department, Government of Khyber Pakhtunkhwa</div>
                    <div class="text-muted small">Affiliated with <strong>University of Swat</strong> &bull; Semester Examination Wing</div>
                </div>
                <!-- Verification QR Code -->
                <div class="text-center">
                    <img src="@Model.VerificationQrUrl" alt="Verification QR Code" style="width: 75px; height: 75px;" class="border p-1 bg-white" />
                    <div style="font-size: 0.65rem;" class="text-muted mt-1 font-monospace">SCAN TO VERIFY</div>
                </div>
            </div>

            <div class="mt-3 pt-2 border-top">
                <span class="badge bg-success px-4 py-1.5 text-uppercase fw-bold font-monospace" style="letter-spacing: 1.5px; font-size: 0.88rem;">
                    Detailed Marks Certificate (DMC) &bull; Semester @Model.Semester
                </span>
            </div>
        </div>

        <!-- Student Particulars Grid -->
        <div class="row g-3 small mb-4 position-relative" style="z-index: 1;">
            <div class="col-6 col-md-3">
                <span class="text-muted">Student Name:</span>
                <div class="fw-bold text-dark fs-6">@Model.Student.FullName</div>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">Father's Name:</span>
                <div class="fw-bold text-dark fs-6">@Model.Student.FatherName</div>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">College Roll No:</span>
                <div class="fw-bold text-success fs-6 font-monospace">@Model.Student.RollNumber</div>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">Registration No:</span>
                <div class="fw-bold text-dark fs-6 font-monospace">@Model.Student.RegistrationNo</div>
            </div>
            <div class="col-6 col-md-6">
                <span class="text-muted">Degree Program:</span>
                <div class="fw-bold text-dark">@Model.Student.Program?.Title (4-Year BS)</div>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">Academic Session:</span>
                <div class="fw-bold text-dark">@Model.AcademicSession</div>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">Issue Date:</span>
                <div class="fw-bold text-dark">@Model.IssueDate.ToString("dd-MMM-yyyy")</div>
            </div>
        </div>

        <!-- Course Evaluation Table -->
        <div class="table-responsive mb-4 position-relative" style="z-index: 1;">
            <table class="table table-bordered table-sm align-middle text-center small mb-0">
                <thead class="table-light border-dark">
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th class="text-start">Course Code &amp; Title</th>
                        <th style="width: 60px;">Cr. Hrs</th>
                        <th style="width: 70px;">Mid (30)</th>
                        <th style="width: 70px;">Sess (20)</th>
                        <th style="width: 70px;">Final (50)</th>
                        <th style="width: 80px;">Total (100)</th>
                        <th style="width: 65px;">Grade</th>
                        <th style="width: 70px;">GP</th>
                        <th style="width: 70px;">QP</th>
                        <th style="width: 70px;">Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNum = 1; }
                    @foreach (var cr in Model.CourseResults)
                    {
                        <tr>
                            <td>@rowNum</td>
                            <td class="text-start">
                                <span class="fw-bold font-monospace">@cr.CourseCode:</span> @cr.CourseTitle
                            </td>
                            <td>@cr.CreditHours</td>
                            <td>@cr.MidTermMarks.ToString("0.#")</td>
                            <td>@cr.SessionalMarks.ToString("0.#")</td>
                            <td>@cr.FinalMarks.ToString("0.#")</td>
                            <td class="fw-bold">@cr.TotalMarks.ToString("0.#")</td>
                            <td class="fw-bold">@cr.Grade</td>
                            <td>@cr.GradePoints.ToString("0.00")</td>
                            <td class="font-monospace">@cr.QualityPoints.ToString("0.00")</td>
                            <td><span class="badge bg-success bg-opacity-75">@cr.Remarks</span></td>
                        </tr>
                        rowNum++;
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="2" class="text-end">Summary:</td>
                        <td>@Model.TotalCreditHours</td>
                        <td colspan="6" class="text-end">Total Quality Points (QP):</td>
                        <td class="font-monospace text-success">@Model.TotalQualityPoints.ToString("0.00")</td>
                        <td>—</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- GPA Statistics & Grading Key -->
        <div class="row g-3 align-items-center mb-5 position-relative" style="z-index: 1;">
            <div class="col-12 col-md-6">
                <div class="p-3 bg-light rounded border border-success border-opacity-25">
                    <div class="row text-center">
                        <div class="col-6 border-end">
                            <span class="text-muted small">Semester GPA (SGPA)</span>
                            <div class="h3 fw-bold text-success mb-0 font-monospace">@Model.Sgpa.ToString("0.00")</div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small">Cumulative GPA (CGPA)</span>
                            <div class="h3 fw-bold text-dark mb-0 font-monospace">@Model.Cgpa.ToString("0.00")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 small text-muted">
                <strong>University of Swat Grading Scale:</strong>
                <div>A: 80-100% (4.00) &bull; B: 65-79% (3.00) &bull; C: 50-64% (2.00)</div>
                <div>Probation Policy: Cumulative CGPA below 2.00 leads to academic warning.</div>
            </div>
        </div>

        <!-- Signatures & Authority -->
        <div class="row text-center pt-5 mt-4 position-relative border-top" style="z-index: 1;">
            <div class="col-4">
                <div class="fw-bold text-dark">Clerk / Tabulator</div>
                <div class="text-muted small">Prepared By</div>
            </div>
            <div class="col-4">
                <div class="fw-bold text-dark">Superintendent Examination</div>
                <div class="text-muted small">Verified By</div>
            </div>
            <div class="col-4">
                <div class="fw-bold text-success">@Model.ControllerName</div>
                <div class="text-muted small">Controller of Examinations</div>
            </div>
        </div>
    </div>
</div>
