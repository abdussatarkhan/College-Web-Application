@{
    ViewData["Title"] = "Student Account Not Linked";
}

<div class="card card-portal shadow-sm text-center py-5 my-5">
    <div class="card-body">
        <i class="bi bi-person-x-fill text-warning" style="font-size: 4rem;"></i>
        <h4 class="fw-bold text-dark mt-3">Student Profile Not Linked</h4>
        <p class="text-muted mx-auto" style="max-width: 520px;">
            Your account is currently not linked to an active student registration profile. Please contact the <strong>GDC Madyan Swat Student Information System (SIS) Admin</strong> or the <strong>Chief Proctor Office</strong> with your CNIC and College Roll Number to link your profile.
        </p>
        <div class="d-flex justify-content-center gap-3 mt-4">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary" style="background-color: #0B6623; border-color: #0B6623;">
                <i class="bi bi-house-door-fill me-1"></i> Return to Homepage
            </a>
            <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-right me-1"></i> Sign Out
            </a>
        </div>
    </div>
</div>
