@model College_Web_Application.Models.ViewModels.StudentPortalDashboardViewModel
@{
    ViewData["Title"] = "Student Portal - Attendance & Exam Eligibility";
}

<div class="container-fluid px-0">
    <!-- STUDENT PROFILE HERO BANNER -->
    <div class="card card-portal shadow-sm border-0 mb-4 overflow-hidden">
        <div class="card-body p-4 text-white" style="background: linear-gradient(135deg, #063B13 0%, #0F172A 100%);">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(Model.Student.PhotoUrl) ? "/images/student-avatar.png" : Model.Student.PhotoUrl)" 
                             alt="@Model.Student.FullName" 
                             class="rounded-circle border border-3 border-warning shadow" 
                             style="width: 80px; height: 80px; object-fit: cover; background: #fff;" 
                             onerror="this.src='/images/crest-placeholder.png'" />
                        <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success border border-white p-1">
                            <span class="visually-hidden">Active</span>
                        </span>
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h4 class="fw-bold mb-0 text-white">@Model.Student.FullName</h4>
                        <span class="badge badge-gold font-monospace">@Model.Student.RollNumber</span>
                        <span class="badge bg-light text-dark font-monospace">Reg: @Model.Student.RegistrationNo</span>
                    </div>
                    <div class="text-light opacity-80 small mb-2">
                        S/O @Model.Student.FatherName &bull; @Model.Student.Program?.Title &bull; Semester @Model.Student.CurrentSemester (Section @Model.Student.Section)
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="badge bg-white text-success fw-bold px-3 py-1.5 shadow-sm">
                            <i class="bi bi-mortarboard-fill me-1"></i> CGPA: @Model.Student.CGPA.ToString("0.00")
                        </span>
                        <span class="badge bg-dark text-warning border border-warning px-3 py-1.5">
                            <i class="bi bi-clock-history me-1"></i> Session: Fall 2026
                        </span>
                        @if (Model.Student.AcademicStatus == College_Web_Application.Models.AcademicStatus.Rusticated_ParentRequired)
                        {
                            <span class="badge bg-danger text-white px-3 py-1.5">
                                <i class="bi bi-slash-circle me-1"></i> RUSTICATED (Attendance Shortage)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success bg-opacity-75 text-white px-3 py-1.5">
                                <i class="bi bi-shield-check me-1"></i> Good Academic Standing
                            </span>
                        }
                    </div>
                </div>
                <div class="col-12 col-md-auto text-md-end mt-3 mt-md-0">
                    @if (Model.CanDownloadRollNoSlip)
                    {
                        <a asp-action="RollNoSlip" class="btn btn-warning fw-bold px-4 py-2 shadow">
                            <i class="bi bi-card-checklist me-1"></i> Examination Roll No Slip
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary px-4 py-2" disabled title="Debarred in all courses due to attendance shortage">
                            <i class="bi bi-lock-fill me-1"></i> Roll No Slip Locked
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ELIGIBILITY ALERT BANNER -->
    @if (!Model.IsAnyCourseDebarred)
    {
        <div class="alert alert-success border-success border-start border-4 shadow-sm p-3 mb-4 rounded-3 d-flex align-items-center gap-3">
            <i class="bi bi-patch-check-fill fs-2 text-success flex-shrink-0"></i>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-1 text-dark">HEC 75% Attendance Requirement Satisfied</h6>
                <div class="small text-secondary">
                    Congratulations! Your attendance meets or exceeds the mandatory 75% threshold in all enrolled courses for Semester @Model.Student.CurrentSemester. Your Final Term Examination Roll Number Slip is fully validated.
                </div>
            </div>
            <a asp-action="RollNoSlip" class="btn btn-outline-success btn-sm fw-bold flex-shrink-0">
                <i class="bi bi-printer me-1"></i> View Slip
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-warning border-warning border-start border-4 shadow-sm p-3 mb-4 rounded-3 d-flex align-items-center gap-3">
            <i class="bi bi-exclamation-triangle-fill fs-2 text-warning flex-shrink-0"></i>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-1 text-dark">Attention Required: Attendance Shortage Detected</h6>
                <div class="small text-secondary">
                    You have attendance shortages in <strong>@(Model.WarningCoursesCount + Model.DebarredCoursesCount) course(s)</strong>.
                    Per HEC and University of Swat policy, you must attain 75% to sit in the Final Term Exam. Review the smart recovery guidance below or contact the Principal Office for medical condonation waiver.
                </div>
            </div>
            <a href="#recoverySection" class="btn btn-outline-warning text-dark btn-sm fw-bold flex-shrink-0">
                <i class="bi bi-arrow-down-circle me-1"></i> View Action Plan
            </a>
        </div>
    }

    <!-- METRIC CARDS ROW -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card card-portal shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Overall Attendance</span>
                        <i class="bi bi-pie-chart-fill text-success fs-5"></i>
                    </div>
                    <div class="fs-3 fw-bold @(Model.OverallAttendancePercentage >= 75 ? "text-success" : (Model.OverallAttendancePercentage >= 65 ? "text-warning" : "text-danger"))">
                        @Model.OverallAttendancePercentage.ToString("0.0")%
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar @(Model.OverallAttendancePercentage >= 75 ? "bg-success" : (Model.OverallAttendancePercentage >= 65 ? "bg-warning" : "bg-danger"))" 
                             style="width: @Math.Min(100, Model.OverallAttendancePercentage)%;"></div>
                    </div>
                    <div class="small text-muted mt-2">Across all semester courses</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-portal shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Eligible Courses</span>
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    </div>
                    <div class="fs-3 fw-bold text-success">@Model.EligibleCoursesCount</div>
                    <div class="small text-muted mt-2">&ge; 75% lectures attended</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-portal shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Condonation Zone</span>
                        <i class="bi bi-exclamation-circle-fill text-warning fs-5"></i>
                    </div>
                    <div class="fs-3 fw-bold text-warning-emphasis">@Model.WarningCoursesCount</div>
                    <div class="small text-muted mt-2">65.0% to 74.9% (Waiver eligible)</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card card-portal shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Debarred Courses</span>
                        <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                    </div>
                    <div class="fs-3 fw-bold text-danger">@Model.DebarredCoursesCount</div>
                    <div class="small text-muted mt-2">&lt; 65% (Repeat required)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- COURSE ATTENDANCE MATRIX & SMART RECOVERY CALCULATOR -->
    <div class="card card-portal shadow-sm mb-4" id="recoverySection">
        <div class="card-header-portal d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-mortarboard text-success fs-5"></i>
                <span>Semester @Model.Student.CurrentSemester Course Attendance & Exam Clearance Matrix</span>
            </div>
            <span class="badge bg-light text-dark border">
                Statutory Benchmark: 75.0%
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th style="width: 40px;" class="text-center">#</th>
                            <th style="min-width: 220px;">Course Title & Code</th>
                            <th class="text-center" style="width: 80px;">Cr. Hrs</th>
                            <th class="text-center" style="width: 140px;">Lectures Held</th>
                            <th class="text-center" style="min-width: 150px;">Attendance %</th>
                            <th class="text-center" style="width: 150px;">Exam Eligibility</th>
                            <th style="min-width: 280px;">Smart Recovery Formula & Guidance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AttendanceEvaluations.Any())
                        {
                            int idx = 1;
                            foreach (var item in Model.AttendanceEvaluations)
                            {
                                <tr class="@(item.IsDebarredFromFinalExam ? "table-danger bg-opacity-10" : "")">
                                    <td class="text-center fw-semibold text-muted">@idx</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.CourseCode</div>
                                        <div class="small text-secondary">@item.CourseTitle</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@item.CreditHours</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="fw-bold text-dark">
                                            @(item.TotalPresent + item.TotalLeave) / @item.TotalLecturesConducted
                                        </div>
                                        <div class="small text-muted" style="font-size: 0.72rem;">
                                            (@item.TotalPresent P, @item.TotalLeave L, @item.TotalAbsent A)
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                                            <span class="fs-6 fw-bold @(item.AttendancePercentage >= 75 ? "text-success" : (item.AttendancePercentage >= 65 ? "text-warning" : "text-danger"))">
                                                @item.AttendancePercentage.ToString("0.0")%
                                            </span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @(item.AttendancePercentage >= 75 ? "bg-success" : (item.AttendancePercentage >= 65 ? "bg-warning" : "bg-danger"))" 
                                                 style="width: @Math.Min(100, item.AttendancePercentage)%;"></div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsCondonedByPrincipal)
                                        {
                                            <span class="badge bg-success text-white px-2 py-1.5 shadow-sm">
                                                <i class="bi bi-patch-check-fill me-1"></i> CONDONED
                                            </span>
                                            <div class="small text-success mt-1" style="font-size: 0.7rem;">Waiver Approved</div>
                                        }
                                        else if (item.Status == College_Web_Application.Services.AttendanceEligibilityStatus.Eligible)
                                        {
                                            <span class="badge bg-success text-white px-2 py-1.5 shadow-sm">
                                                <i class="bi bi-check-circle-fill me-1"></i> ELIGIBLE
                                            </span>
                                            <div class="small text-muted mt-1" style="font-size: 0.7rem;">Roll No Slip Valid</div>
                                        }
                                        else if (item.Status == College_Web_Application.Services.AttendanceEligibilityStatus.NotEnoughData)
                                        {
                                            <span class="badge bg-info text-dark px-2 py-1.5">
                                                <i class="bi bi-info-circle me-1"></i> IN PROGRESS
                                            </span>
                                            <div class="small text-muted mt-1" style="font-size: 0.7rem;">&lt; 10 Lectures Held</div>
                                        }
                                        else if (item.Status == College_Web_Application.Services.AttendanceEligibilityStatus.CondonationZone)
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1.5 fw-bold shadow-sm">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> WARNING
                                            </span>
                                            <div class="small text-danger mt-1" style="font-size: 0.7rem;">Debarred unless condoned</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white px-2 py-1.5 shadow-sm">
                                                <i class="bi bi-slash-circle-fill me-1"></i> DEBARRED
                                            </span>
                                            <div class="small text-danger mt-1" style="font-size: 0.7rem;">Ineligible for Final</div>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ClassesNeededToReach75 > 0 && !item.IsCondonedByPrincipal)
                                        {
                                            <div class="p-2 rounded bg-light border border-warning border-opacity-50">
                                                <div class="d-flex align-items-center gap-1 text-danger fw-bold small mb-1">
                                                    <i class="bi bi-lightning-charge-fill text-warning"></i>
                                                    <span>Action Required: Attend next @item.ClassesNeededToReach75 classes</span>
                                                </div>
                                                <div class="text-muted" style="font-size: 0.75rem;">
                                                    Mathematical recovery formula \(x = 3C - 4P\): By attending the next <strong>@item.ClassesNeededToReach75 consecutive lecture(s)</strong> without any absence, your attendance will recover to exactly <strong>75.0%</strong>.
                                                </div>
                                                @if (item.Status == College_Web_Application.Services.AttendanceEligibilityStatus.CondonationZone)
                                                {
                                                    <div class="mt-1 small text-dark fw-semibold" style="font-size: 0.72rem;">
                                                        <i class="bi bi-info-circle me-1 text-primary"></i> Or submit Bank of Khyber condonation fee challan + medical proof to Principal Office for waiver.
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (item.IsCondonedByPrincipal)
                                        {
                                            <div class="p-2 rounded bg-success bg-opacity-10 border border-success border-opacity-25 small text-success">
                                                <i class="bi bi-shield-check me-1"></i> Principal Condonation active. You have been permitted to sit in the Final Examination for this course.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-success">
                                                <i class="bi bi-check-all fs-6 me-1"></i> Satisfactory standing. Maintain your current attendance routine through semester end.
                                            </div>
                                        }
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No course attendance records registered for this semester.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- STATUTORY HEC & UNIVERSITY OF SWAT POLICY REFERENCE -->
    <div class="card card-portal shadow-sm mb-4">
        <div class="card-header-portal">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-book-half text-success fs-5"></i>
                <span>Official Attendance Rules & Examination Regulations (HEC / University of Swat)</span>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100 bg-light">
                        <div class="d-flex align-items-center gap-2 text-success fw-bold mb-2">
                            <i class="bi bi-check2-circle fs-5"></i>
                            <span>Tier 1: 75% and Above (Eligible)</span>
                        </div>
                        <p class="small text-muted mb-0">
                            Students who attend 75% or more of total conducted lectures are unconditionally eligible to sit in the Final Term Examinations and receive official grades and GPAs.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100 bg-light">
                        <div class="d-flex align-items-center gap-2 text-warning fw-bold mb-2">
                            <i class="bi bi-exclamation-triangle fs-5"></i>
                            <span>Tier 2: 65% to 74.9% (Condonation)</span>
                        </div>
                        <p class="small text-muted mb-0">
                            Students falling in this zone are debarred by default, but may apply to the <strong>Principal / Academic Committee</strong> for a medical or official emergency condonation waiver upon paying the Bank of Khyber condonation fee.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100 bg-light">
                        <div class="d-flex align-items-center gap-2 text-danger fw-bold mb-2">
                            <i class="bi bi-x-octagon fs-5"></i>
                            <span>Tier 3: Below 65% (Strictly Debarred)</span>
                        </div>
                        <p class="small text-muted mb-0">
                            Students with less than 65% attendance cannot be condoned under University of Swat statutes. The course is marked as <strong>"SA (F)"</strong> and the student must re-register and repeat the course in a subsequent semester.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
