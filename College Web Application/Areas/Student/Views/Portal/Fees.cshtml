@model College_Web_Application.Models.ViewModels.StudentFeeListViewModel
@{
    ViewData["Title"] = "Fee Vouchers & Payment History";
    Layout = "_Layout";
}

<div class="container py-4">
    <!-- Header with Breadcrumb -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Student Portal</a></li>
                    <li class="breadcrumb-item active">Financial Ledger</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-0">
                <i class="bi bi-wallet2 text-success me-2"></i>Fee Vouchers & Payment Ledger
            </h3>
            <p class="text-muted small mb-0">
                Candidate: <strong>@Model.Student.FullName</strong> (Roll No: <span class="font-monospace">@Model.Student.RollNumber</span>) &bull; @Model.Student.Program?.Title
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- 3 Summary Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0 bg-white rounded-3 p-3 h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Total Assessed Fees</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary p-2 rounded-circle">
                        <i class="bi bi-receipt fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-1">PKR @Model.TotalBilled.ToString("N0")</h3>
                <div class="small text-muted">All semesters tuition & institutional funds</div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0 bg-white rounded-3 p-3 h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Total Paid / Cleared</span>
                    <span class="badge bg-success bg-opacity-10 text-success p-2 rounded-circle">
                        <i class="bi bi-check2-circle fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-bold text-success mb-1">PKR @Model.TotalPaid.ToString("N0")</h3>
                <div class="small text-success fw-semibold">
                    <i class="bi bi-shield-check me-1"></i> Verified by College Accounts Section
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0 bg-white rounded-3 p-3 h-100 border-start border-4 @(Model.TotalOutstanding > 0 ? "border-danger" : "border-secondary")">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Outstanding Dues</span>
                    <span class="badge @(Model.TotalOutstanding > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-light text-muted") p-2 rounded-circle">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-bold @(Model.TotalOutstanding > 0 ? "text-danger" : "text-dark") mb-1">
                    PKR @Model.TotalOutstanding.ToString("N0")
                </h3>
                <div class="small @(Model.TotalOutstanding > 0 ? "text-danger fw-semibold" : "text-muted")">
                    @(Model.TotalOutstanding > 0 ? "Requires payment before exam clearance" : "All dues cleared. No pending balance.")
                </div>
            </div>
        </div>
    </div>

    <!-- Challans List -->
    <div class="card shadow-sm border-0 rounded-3 mb-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-dark mb-0">
                <i class="bi bi-table me-2 text-primary"></i>Issued Fee Challan Vouchers
            </h6>
            <span class="badge bg-light text-secondary border">The Bank of Khyber (BoK) / NBP Madyan</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th class="ps-3">Challan Number</th>
                        <th>Semester</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th>Tuition & Funds</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (Model.Challans.Any())
                    {
                        foreach (var f in Model.Challans)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="font-monospace fw-bold text-dark">@f.ChallanNumber</div>
                                    @if (!string.IsNullOrEmpty(f.BankReference))
                                    {
                                        <div class="text-muted small font-monospace" style="font-size: 0.72rem;">Ref: @f.BankReference</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">Sem @f.Semester</span>
                                </td>
                                <td class="text-muted">@f.IssueDate.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    <span class="@(!f.IsPaid && f.DueDate < DateTime.UtcNow ? "text-danger fw-bold" : "text-muted")">
                                        @f.DueDate.ToString("dd-MMM-yyyy")
                                    </span>
                                </td>
                                <td>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        Tuition: PKR @f.TuitionFee.ToString("N0") &bull; Exam: PKR @f.ExamFee.ToString("N0")
                                    </div>
                                    @if (f.LateFine > 0 && !f.IsPaid && f.DueDate < DateTime.UtcNow)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger" style="font-size: 0.68rem;">+ Late Fee Rs @f.LateFine.ToString("N0")</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">PKR @f.TotalAmount.ToString("N0")</div>
                                </td>
                                <td>
                                    @if (f.IsPaid)
                                    {
                                        <span class="badge bg-success text-white px-2.5 py-1.5 fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i> PAID
                                        </span>
                                        <div class="text-muted mt-1" style="font-size: 0.7rem;">@f.PaidDate?.ToString("dd-MMM-yyyy")</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-2.5 py-1.5 fw-bold">
                                            <i class="bi bi-clock-history me-1"></i> UNPAID
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="PrintChallan" asp-route-id="@f.Id" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        <i class="bi bi-printer me-1"></i> Print Voucher
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No fee vouchers have been generated for your record yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Instruction Guide -->
    <div class="card shadow-sm border-0 rounded-3 bg-light p-4">
        <h6 class="fw-bold text-dark text-uppercase mb-2">
            <i class="bi bi-info-circle-fill text-primary me-2"></i>Official Bank Deposit Procedure
        </h6>
        <div class="row g-3 small text-secondary">
            <div class="col-12 col-md-4">
                <div class="d-flex align-items-start gap-2">
                    <span class="badge bg-primary text-white rounded-circle p-2">1</span>
                    <div>
                        <strong>Print 3-Part Voucher:</strong> Click "Print Voucher" to print the standard Bank of Khyber A4 voucher containing Bank, College, and Student copies.
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="d-flex align-items-start gap-2">
                    <span class="badge bg-primary text-white rounded-circle p-2">2</span>
                    <div>
                        <strong>Authorized Bank Branch:</strong> Deposit payment over-the-counter at <strong>The Bank of Khyber (Madyan Branch, Code 0142)</strong> or any online BoK / NBP branch nationwide.
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="d-flex align-items-start gap-2">
                    <span class="badge bg-primary text-white rounded-circle p-2">3</span>
                    <div>
                        <strong>Automatic Reconciliation:</strong> Retain the stamped Student Copy. The bank uploads the daily scroll, and your portal will reflect "PAID" within 24 hours.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
