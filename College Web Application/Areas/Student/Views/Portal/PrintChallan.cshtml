@model College_Web_Application.Models.FeeChallan
@{
    ViewData["Title"] = $"Fee Challan - {Model.ChallanNumber}";
    Layout = null; // Standalone printable document
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fee Voucher - @Model.ChallanNumber - GDC Madyan Swat</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
            margin: 0;
            padding: 15px;
            font-size: 11px;
        }

        .arabic-motto {
            font-family: 'Amiri', serif;
            font-size: 13px;
        }

        .voucher-sheet {
            background: #ffffff;
            max-width: 1200px;
            margin: 0 auto;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-radius: 6px;
            overflow: hidden;
        }

        .voucher-column {
            padding: 14px;
            position: relative;
        }

        .voucher-column:not(:last-child) {
            border-right: 2px dashed #94a3b8;
        }

        .copy-pill {
            display: inline-block;
            background: #0B6623;
            color: #ffffff;
            font-weight: 700;
            font-size: 10px;
            text-transform: uppercase;
            padding: 3px 10px;
            border-radius: 4px;
            letter-spacing: 0.8px;
        }

        .bank-info-box {
            background-color: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            padding: 6px 8px;
            margin-bottom: 8px;
            font-size: 10px;
        }

        .table-fee {
            width: 100%;
            margin-bottom: 8px;
            font-size: 10.5px;
            border-collapse: collapse;
        }

        .table-fee th, .table-fee td {
            border: 1px solid #cbd5e1;
            padding: 3px 6px;
        }

        .table-fee th {
            background-color: #f1f5f9;
            font-weight: 700;
        }

        .signature-line {
            border-top: 1px solid #64748b;
            padding-top: 4px;
            font-size: 9.5px;
            text-align: center;
            color: #475569;
        }

        @@media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
                font-size: 10px;
            }
            .d-print-none {
                display: none !important;
            }
            .voucher-sheet {
                box-shadow: none !important;
                border-radius: 0 !important;
                max-width: 100% !important;
                width: 100% !important;
            }
            .voucher-column {
                padding: 8px !important;
            }
            @@page {
                size: A4 landscape;
                margin: 8mm 6mm;
            }
        }
    </style>
</head>
<body>

    <!-- Non-printable top action bar -->
    <div class="container-fluid d-print-none mb-3" style="max-width: 1200px;">
        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded shadow-sm border">
            <div>
                <a asp-action="Fees" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Fee Ledger
                </a>
                <span class="ms-3 text-muted small">Official 3-Part Bank Challan: <strong>@Model.ChallanNumber</strong></span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" onclick="window.print()" class="btn btn-success btn-sm px-4 fw-bold shadow-sm">
                    <i class="bi bi-printer-fill me-1"></i> Print Voucher (A4 Landscape)
                </button>
            </div>
        </div>
    </div>

    <!-- 3-Column Voucher Sheet -->
    <div class="voucher-sheet">
        <div class="row g-0">
            @for (int copy = 1; copy <= 3; copy++)
            {
                string copyName = copy switch {
                    1 => "BANK COPY (To be retained by BoK)",
                    2 => "COLLEGE COPY (Submit to Accounts Section)",
                    _ => "STUDENT COPY (Keep for record)"
                };

                <div class="col-4 voucher-column">
                    <!-- Column Header -->
                    <div class="text-center mb-2">
                        <div class="arabic-motto text-success fw-bold">رَبِّ زِدْنِي عِلْماً</div>
                        <h6 class="fw-bold mb-0 text-dark" style="font-size: 12px; letter-spacing: 0.5px;">GOVT DEGREE COLLEGE MADYAN</h6>
                        <div class="text-muted fw-semibold" style="font-size: 9.5px;">DISTRICT SWAT, KHYBER PAKHTUNKHWA</div>
                        <div class="mt-1">
                            <span class="copy-pill">@copyName</span>
                        </div>
                    </div>

                    <!-- Bank Account Details -->
                    <div class="bank-info-box">
                        <div class="d-flex justify-content-between">
                            <strong>Bank:</strong>
                            <span class="text-success fw-bold">The Bank of Khyber</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <strong>Branch:</strong>
                            <span>Madyan Branch (Code: 0142)</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <strong>A/C Title:</strong>
                            <span>Principal GDC Madyan Swat</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <strong>Account No:</strong>
                            <span class="font-monospace fw-bold text-dark">2001-928371-001</span>
                        </div>
                    </div>

                    <!-- Challan Metadata -->
                    <table class="table-fee mb-2">
                        <tbody>
                            <tr>
                                <th style="width: 35%;">Challan No:</th>
                                <td class="font-monospace fw-bold text-dark">@Model.ChallanNumber</td>
                            </tr>
                            <tr>
                                <th>Issue Date:</th>
                                <td>@Model.IssueDate.ToString("dd-MMM-yyyy")</td>
                            </tr>
                            <tr>
                                <th>Due Date:</th>
                                <td class="fw-bold text-danger">@Model.DueDate.ToString("dd-MMM-yyyy")</td>
                            </tr>
                            <tr>
                                <th>Student Roll No:</th>
                                <td class="font-monospace fw-bold text-dark">@(Model.Student?.RollNumber ?? "N/A")</td>
                            </tr>
                            <tr>
                                <th>Student Name:</th>
                                <td class="fw-bold text-dark text-uppercase">@(Model.Student?.FullName ?? "N/A")</td>
                            </tr>
                            <tr>
                                <th>Father Name:</th>
                                <td class="text-uppercase">@(Model.Student?.FatherName ?? "N/A")</td>
                            </tr>
                            <tr>
                                <th>Program & Sem:</th>
                                <td>@(Model.Student?.Program?.Title ?? "BS") - Sem @Model.Semester</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Fee Item Breakdown -->
                    <table class="table-fee text-end">
                        <thead>
                            <tr class="text-center">
                                <th class="text-start" style="width: 65%;">Fee Head Description</th>
                                <th style="width: 35%;">Amount (PKR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-start">Semester Tuition Fee</td>
                                <td>@Model.TuitionFee.ToString("N0")</td>
                            </tr>
                            @if (Model.AdmissionFee > 0)
                            {
                                <tr>
                                    <td class="text-start">Admission / Enrollment Fee</td>
                                    <td>@Model.AdmissionFee.ToString("N0")</td>
                                </tr>
                            }
                            <tr>
                                <td class="text-start">Semester Examination Fee</td>
                                <td>@Model.ExamFee.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td class="text-start">Library Security & Dev Fund</td>
                                <td>@Model.LibraryFund.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td class="text-start">Science / IT Laboratory Fund</td>
                                <td>@Model.LabFund.ToString("N0")</td>
                            </tr>
                            @if (Model.LateFine > 0 && !Model.IsPaid && Model.DueDate < DateTime.UtcNow)
                            {
                                <tr class="table-danger">
                                    <td class="text-start fw-bold text-danger">Late Payment Fine</td>
                                    <td class="fw-bold text-danger">@Model.LateFine.ToString("N0")</td>
                                </tr>
                            }
                            <tr class="table-light fw-bold">
                                <td class="text-start text-dark">TOTAL PAYABLE:</td>
                                <td class="text-success fs-6">PKR @Model.TotalAmount.ToString("N0")</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Verification QR & Instructions -->
                    <div class="d-flex align-items-center justify-content-between mb-3 pt-1">
                        <div style="font-size: 8.5px; line-height: 1.3;" class="text-secondary pe-2">
                            <div>&bull; Payment acceptable at any online BoK / NBP branch.</div>
                            <div>&bull; Fees once deposited are strictly non-refundable.</div>
                            <div class="mt-1 font-monospace text-muted">IDOR SECURE: #@Model.Id</div>
                        </div>
                        <div class="text-center flex-shrink-0">
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=55x55&data=https%3A%2F%2Fgdcmadyan.edu.pk%2Fverify%2Fchallan%2F@Model.ChallanNumber" 
                                 alt="QR Verification" style="width: 50px; height: 50px; border: 1px solid #ccc; padding: 1px;" />
                        </div>
                    </div>

                    <!-- Signatures Block -->
                    <div class="row g-2 pt-2 mt-2">
                        <div class="col-6">
                            <div class="signature-line">
                                Depositor's Signature
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="signature-line">
                                Bank Cashier & Stamp
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</body>
</html>
