@model College_Web_Application.Models.ViewModels.HomeViewModel
@inject College_Web_Application.Services.IAdmissionSettingsService AdmissionSettingsService
@{
    ViewData["Title"] = "Government Degree College Madyan Swat - Flagship Public Institution";
    var admissionSettings = await AdmissionSettingsService.GetSettingsAsync();
    bool isAnyOpen = admissionSettings.IsBsAdmissionsOpen || admissionSettings.IsFscAdmissionsOpen;
    string applyBtnText = (admissionSettings.IsBsAdmissionsOpen && admissionSettings.IsFscAdmissionsOpen)
        ? "Apply for F.Sc / BS Admission"
        : (admissionSettings.IsBsAdmissionsOpen ? "Apply for BS Admission" : "Apply for F.Sc Admission");
}

<!-- ==========================================================================
     SECTION 1: HERO CAMPUS BANNER WITH DRONE VIDEO & LIVE TICKER (GIKI-STYLE)
     ========================================================================== -->
<section class="hero-campus-banner position-relative overflow-hidden">
    <!-- Cinematic Campus Drone Video Loop Background with Poster & Lazy Fallback -->
    <video autoplay muted loop playsinline class="hero-video-bg" poster="/images/campus-banner.jpg" preload="metadata">
        <source src="~/videos/campus-drone.mp4" type="video/mp4">
    </video>

    <!-- Translucent Emerald & Deep Slate Gradient Overlay for Text Clarity -->
    <div class="hero-overlay"></div>

    <div class="container position-relative hero-content-wrapper">
        <div class="row align-items-center">
            <div class="col-12 col-xl-10">
                <!-- Motto Badge -->
                <div class="hero-motto-badge">
                    <span class="arabic-motto fs-5">رَبِّ زِدْنِي عِلْماً</span>
                    <span class="text-white opacity-50">|</span>
                    <span class="fw-semibold">Est. 2006 | Higher Education Department KP</span>
                </div>

                <!-- Main Heading -->
                <h1 class="hero-heading text-white">
                    Welcome to Government Degree College <span class="text-warning">Madyan Swat</span>
                </h1>

                <!-- Subheading -->
                <p class="hero-subtext">
                    A distinguished seat of higher learning in the Swat Valley, empowering 5,000+ students across <strong>Intermediate (BISE Swat)</strong> and <strong>Undergraduate BS 4-Year (University of Swat)</strong> programs with academic rigor, character building, and digital innovation.
                </p>

                <!-- Call to Action Buttons (Balanced University Palette) -->
                <div class="d-flex flex-wrap gap-2 gap-sm-3">
                    @if (isAnyOpen)
                    {
                        <a asp-controller="Admissions" asp-action="Apply" class="btn btn-warning fw-bold px-3 px-sm-4 py-2 py-sm-2.5 shadow rounded-pill text-dark">
                            <i class="bi bi-pencil-square me-1 me-sm-2"></i> @applyBtnText
                        </a>
                    }
                    <a asp-controller="Admissions" asp-action="MeritLists" class="btn btn-outline-light fw-semibold px-3 px-sm-4 py-2 py-sm-2.5 rounded-pill">
                        <i class="bi bi-card-checklist me-1 me-sm-2"></i> Check Marks-Based Merit Lists
                    </a>
                    <a asp-controller="Admissions" asp-action="Guide" class="btn btn-light fw-semibold px-3 px-sm-4 py-2 py-sm-2.5 rounded-pill shadow-sm text-dark">
                        <i class="bi bi-book me-1 me-sm-2"></i> Admissions Guide
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Official Drone Aerial Footage Indicator Badge -->
    <div class="hero-drone-badge">
        <i class="bi bi-camera-reels-fill text-warning me-1"></i> GDC Madyan Swat &bull; Official Aerial Drone View
    </div>
</section>

<!-- Live Scrolling News Ticker -->
<div class="news-ticker-bar">
    <div class="ticker-label">
        <i class="bi bi-broadcast"></i> LATEST UPDATES
    </div>
    <div class="ticker-content-track">
        <div class="ticker-marquee">
            @if (Model.PinnedNotices.Any())
            {
                foreach (var notice in Model.PinnedNotices)
                {
                    <a class="ticker-item" asp-controller="Notices" asp-action="Index">
                        <span class="badge bg-warning text-dark font-monospace" style="font-size: 0.72rem;">@notice.Category</span>
                        <span>@notice.Title</span>
                        <span class="text-white-50" style="font-size: 0.76rem;">(@notice.PublishedDate.ToString("dd MMM yyyy"))</span>
                        <i class="bi bi-dot text-warning"></i>
                    </a>
                }
            }
            else
            {
                <span class="ticker-item">Welcome to Government Degree College Madyan Swat — Admissions Open for Session 2026-2027</span>
            }
        </div>
    </div>
</div>

<!-- ==========================================================================
     SECTION 2: ANIMATED STAT COUNTERS (5,000+ Students, 110+ Faculty, 20+ Years)
     ========================================================================== -->
<div class="stat-counter-section">
    <div class="container position-relative">
        <div class="stat-counter-grid reveal-fade-up">
            <div class="row g-0">
                <div class="col-6 col-lg-3 stat-counter-item">
                    <div class="stat-number" data-counter-target="@Model.TotalStudents" data-counter-suffix="+">0</div>
                    <div class="stat-label">Enrolled Scholars</div>
                </div>
                <div class="col-6 col-lg-3 stat-counter-item">
                    <div class="stat-number" data-counter-target="@Model.TotalFaculty" data-counter-suffix="+">0</div>
                    <div class="stat-label">Distinguished Professors</div>
                </div>
                <div class="col-6 col-lg-3 stat-counter-item">
                    <div class="stat-number" data-counter-target="@Model.YearsOfExcellence" data-counter-suffix="+">0</div>
                    <div class="stat-label">Years of Academic Rigor</div>
                </div>
                <div class="col-6 col-lg-3 stat-counter-item">
                    <div class="stat-number" data-counter-target="100" data-counter-suffix="%">0</div>
                    <div class="stat-label">Marks Merit Transparency</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================================================
     SECTION 3: THREE STRATEGIC PILLARS (GIKI-STYLE)
     ========================================================================== -->
<section class="py-5" id="about">
    <div class="container">
        <div class="section-title-wrap reveal-fade-up">
            <span class="section-badge-pill">Academic Distinction</span>
            <h2 class="section-heading-main">Flagship Programs &amp; Financial Support</h2>
            <p class="section-subheading-lead">
                Committed to delivering transformative higher education in Swat with state-of-the-art laboratory infrastructure and merit-based access.
            </p>
        </div>

        <div class="row g-4">
            <!-- Pillar 1: Intermediate -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100 reveal-fade-up">
                    <img src="~/images/gallery/2-main-academic-block.jpg" class="card-img-top" alt="Main Academic Block" style="height: 220px; object-fit: cover;" />
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-dark text-white fw-bold px-3 py-1 mb-2 align-self-start">BISE Swat Affiliated</span>
                        <h4 class="fw-bold text-dark mb-2">Intermediate (HSSC 2-Year)</h4>
                        <p class="text-muted small mb-4">
                            Rigorous preparatory education across <strong>F.Sc Pre-Medical</strong>, <strong>Pre-Engineering</strong>, and <strong>ICS Computer Science</strong> with hands-on science and IT labs.
                        </p>
                        @if (admissionSettings.IsFscAdmissionsOpen)
                        {
                            <a asp-controller="Admissions" asp-action="Apply" class="btn btn-outline-dark btn-sm fw-bold rounded-pill mt-auto align-self-start">
                                Apply for Intermediate <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        }
                        else
                        {
                            <span class="badge bg-secondary bg-opacity-25 text-dark mt-auto align-self-start py-1.5 px-3 rounded-pill small">
                                <i class="bi bi-clock me-1"></i> Admissions Closed
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Pillar 2: Undergraduate BS -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100 reveal-fade-up">
                    <img src="~/images/gallery/4-science-bs-blocks.jpg" class="card-img-top" alt="BS and Science Blocks" style="height: 220px; object-fit: cover;" />
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1 mb-2 align-self-start">University of Swat</span>
                        <h4 class="fw-bold text-dark mb-2">Undergraduate BS (4-Year)</h4>
                        <p class="text-muted small mb-4">
                            Four-year degree pathways in <strong>BS Computer Science</strong>, <strong>BS Microbiology</strong>, <strong>BS English</strong>, <strong>BS Urdu</strong>, <strong>BS Chemistry</strong>, and <strong>BS Botany</strong> following the University of Swat semester curriculum.
                        </p>
                        @if (admissionSettings.IsBsAdmissionsOpen)
                        {
                            <a asp-controller="Admissions" asp-action="Apply" class="btn btn-outline-dark btn-sm fw-bold rounded-pill mt-auto align-self-start">
                                Apply for BS 4-Year <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        }
                        else
                        {
                            <span class="badge bg-secondary bg-opacity-25 text-dark mt-auto align-self-start py-1.5 px-3 rounded-pill small">
                                <i class="bi bi-clock me-1"></i> Admissions Closed
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Pillar 3: Scholarships -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100 reveal-fade-up">
                    <img src="~/images/gallery/7-pakistan-flag-campus.jpg" class="card-img-top" alt="Lawn and Pakistan Flag" style="height: 220px; object-fit: cover;" />
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-warning bg-opacity-25 text-dark fw-bold px-3 py-1 mb-2 align-self-start">Need &amp; Merit Based</span>
                        <h4 class="fw-bold text-dark mb-2">HED &amp; HEC Scholarships</h4>
                        <p class="text-muted small mb-4">
                            Substantial financial aid through the <strong>KP Chief Minister Educational Endowment Fund</strong>, <strong>MORA Zakat Scholarships</strong>, and institutional fee waivers.
                        </p>
                        <a asp-controller="Notices" asp-action="Index" asp-route-category="Scholarship" class="btn btn-outline-dark btn-sm fw-bold rounded-pill mt-auto align-self-start">
                            Scholarship Guidelines <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 4: ACADEMIC DISCIPLINES (DEPARTMENT GRID)
     ========================================================================== -->
<section class="py-5 bg-light" id="programs">
    <div class="container">
        <div class="section-title-wrap reveal-fade-up">
            <span class="section-badge-pill">Curricular Scope</span>
            <h2 class="section-heading-main">Academic Departments &amp; BS Faculties</h2>
            <p class="section-subheading-lead">
                Accredited 4-Year BS degree programs under the University of Swat, plus Intermediate streams under BISE Swat.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var dept in Model.Departments)
            {
                string deptIcon = dept.Code switch {
                    "CS" => "bi-laptop-fill",
                    "MCB" => "bi-virus2",
                    "CHEM" => "bi-flask-fill",
                    "BOT" => "bi-flower1",
                    "ENG" => "bi-book-half",
                    "URD" => "bi-feather",
                    _ => "bi-mortarboard-fill"
                };

                string degreeOffered = dept.Code switch {
                    "CS" => "BS Computer Science & ICS",
                    "MCB" => "BS Microbiology (4-Year)",
                    "CHEM" => "BS Chemistry & F.Sc",
                    "BOT" => "BS Botany & F.Sc",
                    "ENG" => "BS English (4-Year)",
                    "URD" => "BS Urdu (4-Year)",
                    _ => "BS 4-Year Program"
                };

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white h-100 reveal-fade-up position-relative overflow-hidden dept-card-modern">
                        <div class="d-flex align-items-start gap-3">
                            <div class="p-3 rounded-3 text-dark bg-light border d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px;">
                                <i class="bi @deptIcon fs-4 text-warning"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h5 class="fw-bold text-dark mb-0">
                                        <a asp-controller="Departments" asp-action="Details" asp-route-id="@dept.Id" class="text-dark text-decoration-none">
                                            @dept.Name
                                        </a>
                                    </h5>
                                    <span class="badge bg-light text-secondary border font-monospace">@dept.Code</span>
                                </div>
                                <div class="small text-muted mb-2 font-monospace" style="font-size: 0.78rem;">
                                    <i class="bi bi-mortarboard me-1 text-warning"></i> @degreeOffered
                                </div>
                                <p class="text-secondary small mb-3" style="line-height: 1.5; font-size: 0.82rem;">
                                    @dept.Description
                                </p>
                                <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                                    <span class="small text-muted" style="font-size: 0.74rem;">HOD: <strong>@dept.HODName</strong></span>
                                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25" style="font-size: 0.7rem;">Univ. of Swat</span>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <a asp-controller="Departments" asp-action="Details" asp-route-id="@dept.Id" class="btn btn-sm btn-outline-dark rounded-pill fw-semibold w-100 text-center">
                                        <i class="bi bi-images text-warning me-1"></i> View Gallery, Faculty &amp; Books <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 5: UPCOMING EVENTS & ACADEMIC CALENDAR PREVIEW
     ========================================================================== -->
<section class="py-5" id="events">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 reveal-fade-up">
            <div>
                <span class="section-badge-pill">Campus Calendar</span>
                <h2 class="section-heading-main mb-1">Upcoming Events &amp; Dates</h2>
            </div>
            <a asp-controller="Home" asp-action="Events" class="btn btn-outline-dark fw-bold rounded-pill px-4">
                Full Calendar <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @if (Model.UpcomingEvents.Any())
            {
                foreach (var ev in Model.UpcomingEvents.Take(4))
                {
                    <div class="col-12 col-md-6">
                        <div class="event-item-card shadow-sm h-100 reveal-fade-up">
                            <div class="event-date-badge">
                                <span class="event-date-day">@ev.EventDate.ToString("dd")</span>
                                <span class="event-date-month">@ev.EventDate.ToString("MMM")</span>
                            </div>
                            <div class="flex-grow-1">
                                <span class="badge @ev.BadgeColor rounded-pill px-2.5 py-0.5 mb-1" style="font-size: 0.7rem;">@ev.Category</span>
                                <h6 class="fw-bold text-dark mb-1">@ev.Title</h6>
                                <p class="text-muted small mb-1" style="font-size: 0.8rem;">@ev.Description</p>
                                <small class="text-secondary"><i class="bi bi-geo-alt-fill text-warning me-1"></i>@ev.Venue</small>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 6: PRINCIPAL'S MESSAGE (BENCHMARKED WITH UNIVERSITY OF SWAT)
     ========================================================================== -->
<section class="py-5 bg-white position-relative overflow-hidden" id="principal-message" style="border-top: 1px solid rgba(0,0,0,0.06); border-bottom: 1px solid rgba(0,0,0,0.06); scroll-margin-top: 110px;">
    <div class="container py-lg-4">
        <!-- Section Title Header (Always visible & never clipped under sticky navbar) -->
        <div class="section-title-wrap reveal-fade-up mb-4">
            <span class="section-badge-pill">
                <i class="bi bi-mortarboard-fill me-1"></i> Leadership &amp; Institutional Vision
            </span>
            <h2 class="section-heading-main">Message from the Principal</h2>
            <p class="section-subheading-lead">
                Empowering the youth of Swat Valley through academic rigor, moral character, and digital innovation.
            </p>
        </div>

        <div class="row align-items-center g-5">
            <!-- Left: Rectangular Framed Portrait (University of Swat Style - Not Circle) -->
            <div class="col-12 col-lg-5 col-xl-4 text-center text-lg-start reveal-fade-up">
                <div class="principal-portrait-card mx-auto" style="max-width: 340px;">
                    <!-- Main Rectangular Portrait Card -->
                    <div class="principal-portrait-frame">
                        <div class="overflow-hidden rounded-2 position-relative" style="background-color: #0c1829;">
                            <img src="~/images/principal-portrait.jpg" 
                                 alt="Mr. Rasheed Ahmad, Principal Government Degree College Madyan Swat" 
                                 class="img-fluid w-100 d-block" 
                                 style="aspect-ratio: 4/5; object-fit: cover; object-position: center top;"
                                 onerror="this.src='/images/principal-rasheed-ahmad.jpg'" />
                            
                            <!-- Gold Institutional Corner Ribbon -->
                            <div class="position-absolute top-0 start-0 m-2.5">
                                <span class="badge bg-dark bg-opacity-75 text-warning border border-warning border-opacity-50 px-2.5 py-1.5 rounded-pill fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                                    <i class="bi bi-award-fill text-warning me-1"></i> HEAD OF INSTITUTION
                                </span>
                            </div>
                        </div>

                        <!-- Formal Nameplate / Credential Block -->
                        <div class="principal-nameplate p-3 text-center bg-light rounded-bottom-2 border-top mt-2">
                            <h5 class="fw-bold text-dark mb-0 letter-spacing-1">Mr. Rasheed Ahmad</h5>
                            <div class="small text-muted fw-bold text-uppercase mt-1" style="font-size: 0.78rem; letter-spacing: 0.8px;">
                                Principal / Director
                            </div>
                            <div class="text-secondary small mt-1" style="font-size: 0.74rem;">
                                Government Degree College Madyan Swat
                            </div>
                            <div class="badge bg-dark bg-opacity-10 text-dark border border-secondary border-opacity-25 mt-2 py-1 px-2.5" style="font-size: 0.7rem;">
                                <i class="bi bi-shield-check text-warning me-1"></i> Higher Education Department KP
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: The Principal's Welcome Address -->
            <div class="col-12 col-lg-7 col-xl-8 reveal-fade-up">
                <div class="ps-lg-3">
                    <div class="d-inline-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 px-3 py-1.5 rounded-pill fw-bold" style="font-size: 0.76rem;">
                            <i class="bi bi-award-fill text-warning me-1"></i> Affiliated with University of Swat
                        </span>
                        <span class="badge bg-dark bg-opacity-10 text-dark border border-secondary border-opacity-25 px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.76rem;">
                            BS 4-Year &bull; Intermediate
                        </span>
                    </div>

                    <h3 class="fw-bold text-dark mb-3" style="font-size: calc(1.2rem + 0.6vw); line-height: 1.3;">
                        Empowering the Youth of Swat Valley through Academic Rigor &amp; Character
                    </h3>

                    <!-- Accent Underline Divider -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div style="height: 3px; width: 60px; background-color: #0B1B3D; border-radius: 2px;"></div>
                        <div style="height: 3px; width: 25px; background-color: #D4AF37; border-radius: 2px;"></div>
                    </div>

                    <!-- Clean University Address Block (No awkward double quote) -->
                    <div class="border-start border-3 border-warning ps-3 ps-md-4 py-1 mb-4">
                        <p class="text-secondary fs-6 mb-3" style="line-height: 1.85; text-align: justify;">
                            It is an immense honor and privilege to welcome you to <strong>Government Degree College Madyan Swat</strong>, a premier seat of higher learning nestled amidst the breathtaking landscape of Upper Swat. Since our establishment in 2006, our unwavering mission has been to provide accessible, high-caliber education that blends intellectual inquiry with character formation, civic responsibility, and moral discipline.
                        </p>
                        <p class="text-secondary fs-6 mb-3" style="line-height: 1.85; text-align: justify;">
                            Affiliated with the <strong>University of Swat</strong> for our BS 4-Year degree programs in <strong>Computer Science, Microbiology, English, Urdu, Chemistry, and Botany</strong>, as well as <strong>BISE Swat</strong> for Intermediate disciplines, our campus provides over 5,000+ students with advanced science and computer laboratories, dedicated faculty, a rich digital library, transparent marks-based admissions, and high-concurrency automated campus management.
                        </p>
                        <p class="text-secondary fs-6 mb-0" style="line-height: 1.85; text-align: justify;">
                            We instill in our students a relentless quest for knowledge, active participation in co-curricular pursuits, and adherence to academic attendance standards. I welcome all aspiring scholars to join us in shaping a luminous future for our nation.
                        </p>
                    </div>

                    <!-- Arabic Motto & Action Buttons -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 border-top gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="arabic-motto text-dark fw-bold fs-4" style="font-family: 'Amiri', serif;">
                                رَبِّ زِدْنِي عِلْماً
                            </div>
                            <span class="text-muted small fst-italic border-start ps-3">&bull; "O My Lord! Increase me in knowledge"</span>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-controller="Admissions" asp-action="Guide" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold shadow-xs">
                                <i class="bi bi-journal-bookmark me-1"></i> Admissions Guide
                            </a>
                            <a asp-controller="Home" asp-action="Contact" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold text-dark shadow-xs">
                                <i class="bi bi-envelope-paper me-1"></i> Contact Principal Office
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 7: ALUMNI SPOTLIGHT
     ========================================================================== -->
<section class="py-5" id="alumni">
    <div class="container">
        <div class="section-title-wrap reveal-fade-up">
            <span class="section-badge-pill">Proud Heritage</span>
            <h2 class="section-heading-main">Distinguished Alumni Spotlight</h2>
            <p class="section-subheading-lead">
                From engineering power grids to healthcare leadership, our graduates serve the nation with honor.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var al in Model.AlumniSpotlights)
            {
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 reveal-fade-up">
                        <span class="badge @al.BadgeClass px-3 py-1 rounded-pill align-self-start mb-3" style="font-size: 0.72rem;">@al.Degree</span>
                        <h5 class="fw-bold text-dark mb-1">@al.FullName</h5>
                        <div class="text-primary small fw-bold mb-2">@al.CurrentRole</div>
                        <div class="text-muted small mb-3"><i class="bi bi-building me-1"></i>@al.Organization</div>
                        <p class="text-secondary small fst-italic mb-0 border-top pt-2">
                            "@al.Quote"
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
