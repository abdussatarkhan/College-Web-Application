@model College_Web_Application.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Government Degree College Madyan Swat - Flagship Public Institution";
}

<!-- ==========================================================================
     SECTION 1: HERO CAMPUS BANNER WITH DRONE VIDEO & LIVE TICKER (GIKI-STYLE)
     ========================================================================== -->
<section class="hero-campus-banner position-relative overflow-hidden">
    <!-- Cinematic Campus Drone Video Loop Background -->
    <video autoplay muted loop playsinline class="hero-video-bg" poster="/images/campus-banner.jpg">
        <source src="~/videos/campus-drone.mp4" type="video/mp4">
    </video>

    <!-- Translucent Emerald & Deep Slate Gradient Overlay for Text Clarity -->
    <div class="hero-overlay"></div>

    <div class="container position-relative hero-content-wrapper">
        <div class="row align-items-center">
            <div class="col-12 col-xl-10">
                <!-- Motto Badge -->
                <div class="hero-motto-badge">
                    <span class="arabic-motto fs-5">رَبِّ زِدْنِي عِلْماً</span>
                    <span class="text-white opacity-50">|</span>
                    <span class="fw-semibold">Est. 2006 | Higher Education Department KP</span>
                </div>

                <!-- Main Heading -->
                <h1 class="hero-heading text-white">
                    Welcome to Government Degree College <span class="text-warning">Madyan Swat</span>
                </h1>

                <!-- Subheading -->
                <p class="hero-subtext">
                    A distinguished seat of higher learning in the Swat Valley, empowering 5,000+ students across <strong>Intermediate (BISE Swat)</strong> and <strong>Undergraduate BS 4-Year (University of Swat)</strong> programs with academic rigor, character building, and digital innovation.
                </p>

                <!-- Call to Action Buttons -->
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Admissions" asp-action="Apply" class="btn btn-warning btn-lg fw-bold px-4 py-2.5 shadow rounded-pill text-dark">
                        <i class="bi bi-pencil-square me-2"></i> Apply for F.Sc / BS Admission
                    </a>
                    <a asp-controller="Admissions" asp-action="MeritLists" class="btn btn-outline-light btn-lg fw-semibold px-4 py-2.5 rounded-pill">
                        <i class="bi bi-card-checklist me-2"></i> Check Merit Lists 2026
                    </a>
                    <a href="#programs" class="btn btn-success btn-lg fw-semibold px-4 py-2.5 rounded-pill border border-white border-opacity-25" style="background-color: rgba(11, 102, 35, 0.85);">
                        <i class="bi bi-book me-2"></i> Explore Programs
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Official Drone Aerial Footage Indicator Badge -->
    <div class="hero-drone-badge">
        <i class="bi bi-camera-reels-fill text-warning me-1"></i> GDC Madyan Swat &bull; Official Aerial Drone View
    </div>
</section>

<!-- Live Scrolling News Ticker -->
<div class="news-ticker-bar">
    <div class="ticker-label">
        <i class="bi bi-broadcast"></i> LATEST UPDATES
    </div>
    <div class="ticker-content-track">
        <div class="ticker-marquee">
            @if (Model.PinnedNotices.Any())
            {
                foreach (var notice in Model.PinnedNotices)
                {
                    <a asp-controller="Notices" asp-action="Index" class="ticker-item">
                        <span class="badge bg-warning text-dark font-monospace" style="font-size: 0.72rem;">@notice.Category</span>
                        <span>@notice.Title</span>
                        <span class="text-white-50" style="font-size: 0.76rem;">(@notice.PublishedDate.ToString("dd MMM yyyy"))</span>
                        <i class="bi bi-dot text-warning"></i>
                    </a>
                }
            }
            else
            {
                <span class="ticker-item">
                    <span class="badge bg-warning text-dark">Admissions</span>
                    <span>Admissions for Fall 2026 BS 4-Year (University of Swat) and Intermediate F.Sc (BISE Swat) are now officially open.</span>
                </span>
            }
        </div>
    </div>
</div>

<!-- ==========================================================================
     SECTION 2: 4 ACTION STRIP CARDS (Lowered cleanly below the ticker)
     ========================================================================== -->
<div class="container action-strip-container">
    <div class="row g-3">
        <!-- Box 1: Admissions Open -->
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Admissions" asp-action="Apply" class="action-card">
                <div>
                    <div class="action-card-icon">
                        <i class="bi bi-door-open-fill"></i>
                    </div>
                    <div class="action-card-title">Admissions Open (F.Sc & BS)</div>
                </div>
                <div class="action-card-link">
                    Click here <i class="bi bi-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Box 2: Program Offers -->
        <div class="col-12 col-sm-6 col-lg-3">
            <a href="#programs" class="action-card">
                <div>
                    <div class="action-card-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div class="action-card-title">Program Offers</div>
                </div>
                <div class="action-card-link">
                    Click here <i class="bi bi-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Box 3: Scholarships -->
        <div class="col-12 col-sm-6 col-lg-3">
            <a href="#scholarships" class="action-card">
                <div>
                    <div class="action-card-icon">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <div class="action-card-title">HED & HEC Scholarships</div>
                </div>
                <div class="action-card-link">
                    Click here <i class="bi bi-arrow-right"></i>
                </div>
            </a>
        </div>

        <!-- Box 4: Merit Lists & Exam Results -->
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Admissions" asp-action="MeritLists" class="action-card">
                <div>
                    <div class="action-card-icon">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <div class="action-card-title">Merit Lists & Results</div>
                </div>
                <div class="action-card-link">
                    Click here <i class="bi bi-arrow-right"></i>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- ==========================================================================
     SECTION 3: WELCOME TO GDC MADYAN SWAT — 3 ACADEMIC PILLAR CARDS
     ========================================================================== -->
<section class="py-5" id="about">
    <div class="container">
        <div class="section-title-wrap">
            <span class="section-badge-gold">Institutional Excellence</span>
            <h2 class="section-main-heading">Welcome to Government Degree College Madyan Swat</h2>
            <p class="section-subheading">
                Established in 2006 to serve the youth of Upper Swat, GDC Madyan provides high-quality public-sector education with state-of-the-art laboratory infrastructure, sports grounds, and dedicated faculty.
            </p>
        </div>

        <div class="row g-4">
            <!-- Pillar 1: Intermediate HSSC Programs (Using Image #2: Main Academic Block) -->
            <div class="col-12 col-lg-4">
                <div class="pillar-card">
                    <div class="pillar-img-box">
                        <img src="~/images/gallery/2-main-academic-block.jpg" alt="Main Academic Block GDC Madyan" onerror="this.src='/images/crest-placeholder.png'" />
                        <div class="pillar-badge-float">
                            <i class="bi bi-building me-1"></i> BISE Swat Affiliated
                        </div>
                    </div>
                    <div class="pillar-body">
                        <h4 class="pillar-title">Intermediate HSSC Programs</h4>
                        <p class="pillar-text">
                            Two-year rigorous foundation programs in <strong>F.Sc Pre-Medical</strong>, <strong>F.Sc Pre-Engineering</strong>, <strong>FCS / ICS Computer Science</strong>, and <strong>FA Humanities</strong> preparing students for professional university entrance tests and careers.
                        </p>
                        <a asp-controller="Admissions" asp-action="Apply" class="btn btn-outline-success btn-sm fw-bold rounded-pill align-self-start">
                            Explore Intermediate <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Pillar 2: Undergraduate BS 4-Year (Using Image #4: BS & Science Blocks) -->
            <div class="col-12 col-lg-4">
                <div class="pillar-card">
                    <div class="pillar-img-box">
                        <img src="~/images/gallery/4-science-bs-blocks.jpg" alt="BS & Science Blocks GDC Madyan" onerror="this.src='/images/crest-placeholder.png'" />
                        <div class="pillar-badge-float">
                            <i class="bi bi-mortarboard me-1"></i> University of Swat
                        </div>
                    </div>
                    <div class="pillar-body">
                        <h4 class="pillar-title">Undergraduate BS 4-Year Programs</h4>
                        <p class="pillar-text">
                            Eight-semester comprehensive degree programs in <strong>BS Computer Science</strong>, <strong>BS Political Science</strong>, and <strong>BS English</strong> under the HEC semester system with advanced software labs, seminar rooms, and research projects.
                        </p>
                        <a asp-controller="Admissions" asp-action="Apply" class="btn btn-outline-success btn-sm fw-bold rounded-pill align-self-start">
                            Explore BS Programs <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Pillar 3: Scholarships & Financial Aid (Using Image #7: Pakistan Flag & Admin Lawn) -->
            <div class="col-12 col-lg-4">
                <div class="pillar-card" id="scholarships">
                    <div class="pillar-img-box">
                        <img src="~/images/gallery/7-pakistan-flag-campus.jpg" alt="Administration Lawn and Flag GDC Madyan" onerror="this.src='/images/crest-placeholder.png'" />
                        <div class="pillar-badge-float">
                            <i class="bi bi-award me-1"></i> Need & Merit Based
                        </div>
                    </div>
                    <div class="pillar-body">
                        <h4 class="pillar-title">HED & HEC Scholarships</h4>
                        <p class="pillar-text">
                            Dedicated financial support through <strong>KP Chief Minister Educational Endowment Fund</strong>, <strong>HEC Need-Based Aid</strong>, <strong>Mora Scholarships</strong>, and <strong>College Merit Fee Concessions</strong> ensuring no talented student is left behind.
                        </p>
                        <a asp-controller="Notices" asp-action="Index" asp-route-category="Scholarship" class="btn btn-outline-success btn-sm fw-bold rounded-pill align-self-start">
                            View Scholarship Guidelines <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 4: "WE OFFER PROGRAMS IN" (GIKI 8-DEPARTMENT ICON GRID)
     ========================================================================== -->
<section class="py-5 bg-light" id="programs">
    <div class="container">
        <div class="section-title-wrap">
            <span class="section-badge-gold">Academic Disciplines</span>
            <h2 class="section-main-heading">We Offer Programs In</h2>
            <p class="section-subheading">
                Explore our diverse range of Intermediate and Undergraduate faculties mentored by qualified professors, associate professors, and lecturers.
            </p>
        </div>

        <div class="row g-3">
            <!-- Dept 1: Computer Science -->
            <div class="col-6 col-md-4 col-lg-3">
                <a href="#campus-life" class="dept-card">
                    <div class="dept-icon-circle">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <div class="dept-card-title">Computer Science & IT</div>
                    <div class="dept-card-sub">BSCS (4-Yr) &bull; FCS / ICS</div>
                </a>
            </div>

            <!-- Dept 2: Biological Sciences -->
            <div class="col-6 col-md-4 col-lg-3">
                <a href="#campus-life" class="dept-card">
                    <div class="dept-icon-circle">
                        <i class="bi bi-capsule"></i>
                    </div>
                    <div class="dept-card-title">Biological Sciences</div>
                    <div class="dept-card-sub">F.Sc Pre-Medical &bull; Botany &bull; Zoology</div>
                </a>
            </div>

            <!-- Dept 3: Physical Sciences -->
            <div class="col-6 col-md-4 col-lg-3">
                <a href="#campus-life" class="dept-card">
                    <div class="dept-icon-circle">
                        <i class="bi bi-gear-wide-connected"></i>
                    </div>
                    <div class="dept-card-title">Physical Sciences</div>
                    <div class="dept-card-sub">F.Sc Pre-Engineering &bull; Physics &bull; Chem</div>
                </a>
            </div>

            <!-- Dept 4: Political Science -->
            <div class="col-6 col-md-4 col-lg-3">
                <a href="#campus-life" class="dept-card">
                    <div class="dept-icon-circle">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                    <div class="dept-card-title">Political Science</div>
                    <div class="dept-card-sub">BS 4-Year &bull; Public Policy</div>
                </a>
            </div>

            <!-- Dept 5: English Literature -->
            <div class="col-6 col-md-4 col-lg-3">
                <a href="#campus-life" class="dept-card">
                    <div class="dept-icon-circle">
                        <i class="bi bi-translate"></i>
                    </div>
                    <div class="dept-card-title">English Literature</div>
                    <div class="dept-card-sub">BS English &bull; Linguistics</div>
                </a>
            </div>

            <!-- Dept 6: Islamic Studies -->
            <div class="col-6 col-md-4 col-lg-3">
                <a href="#campus-life" class="dept-card">
                    <div class="dept-icon-circle">
                        <i class="bi bi-bank"></i>
                    </div>
                    <div class="dept-card-title">Islamic Studies</div>
                    <div class="dept-card-sub">Ethics &bull; Quranic Studies</div>
                </a>
            </div>

            <!-- Dept 7: Urdu & Pashto -->
            <div class="col-6 col-md-4 col-lg-3">
                <a href="#campus-life" class="dept-card">
                    <div class="dept-icon-circle">
                        <i class="bi bi-feather"></i>
                    </div>
                    <div class="dept-card-title">Urdu & Regional Languages</div>
                    <div class="dept-card-sub">Classical Literature &bull; Pashto</div>
                </a>
            </div>

            <!-- Dept 8: Humanities & Social Sciences -->
            <div class="col-6 col-md-4 col-lg-3">
                <a href="#campus-life" class="dept-card">
                    <div class="dept-icon-circle">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="dept-card-title">Humanities & Arts</div>
                    <div class="dept-card-sub">FA General &bull; History &bull; Civics</div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SECTION 5: INTERACTIVE CAMPUS LIFE & FACILITIES PILL TABS (GIKI-STYLE)
     ========================================================================== -->
<section class="py-5" id="campus-life">
    <div class="container">
        <div class="section-title-wrap">
            <span class="section-badge-gold">Life in Madyan Swat</span>
            <h2 class="section-main-heading">Campus Life & Facilities</h2>
            <p class="section-subheading">
                Explore life at GDC Madyan Swat through high-resolution aerial photography, student initiatives, modern laboratories, and manicured alpine botanical gardens.
            </p>
        </div>

        <!-- Pill Tabs Navigation -->
        <ul class="nav nav-pills campus-tabs-nav justify-content-center mb-0" id="campusTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="students-tab" data-bs-toggle="pill" data-bs-target="#tab-students" type="button" role="tab" aria-selected="true">
                    <i class="bi bi-people-fill me-1"></i> Students
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="arch-tab" data-bs-toggle="pill" data-bs-target="#tab-arch" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-compass-fill me-1"></i> Campus Architecture
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="gardens-tab" data-bs-toggle="pill" data-bs-target="#tab-gardens" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-flower1 me-1"></i> Gardens & Environment
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="labs-tab" data-bs-toggle="pill" data-bs-target="#tab-labs" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-building-fill-check me-1"></i> Labs & Corridors
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="drone-tab" data-bs-toggle="pill" data-bs-target="#tab-drone" type="button" role="tab" aria-selected="false">
                    <i class="bi bi-camera-reels-fill me-1"></i> Full Drone Gallery
                </button>
            </li>
        </ul>

        <!-- Tab Content Panes -->
        <div class="tab-content campus-tab-box" id="campusTabsContent">
            
            <!-- TAB 1: STUDENTS (Using Image #5: Students & Walkway) -->
            <div class="tab-pane fade show active" id="tab-students" role="tabpanel" aria-labelledby="students-tab">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-lg-6">
                        <div class="tab-image-container">
                            <img src="~/images/gallery/5-student-life-walkway.jpg" alt="Students walking on GDC Madyan pathway" onerror="this.src='/images/crest-placeholder.png'" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-1.5 mb-2">Vibrant Student Body</span>
                        <h3 class="fw-bold text-dark mb-3">Enriching Academics with Character & Leadership</h3>
                        <p class="text-muted" style="line-height: 1.7;">
                            Over 5,000 enrolled students enjoy a disciplined, safe, and academically stimulating environment nestled along the banks of the Swat River. Student life at GDC Madyan is enriched with student societies, debate teams, science fairs, and community welfare initiatives.
                        </p>
                        <div class="row g-3 mt-2">
                            <div class="col-6">
                                <div class="border rounded p-3 bg-light text-center">
                                    <div class="fs-4 fw-bold text-success font-monospace">5,000+</div>
                                    <div class="small text-muted">Enrolled Students</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border rounded p-3 bg-light text-center">
                                    <div class="fs-4 fw-bold text-warning font-monospace">10+</div>
                                    <div class="small text-muted">Student Societies</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: CAMPUS ARCHITECTURE (Using Image #1: Campus Top-Down Map) -->
            <div class="tab-pane fade" id="tab-arch" role="tabpanel" aria-labelledby="arch-tab">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-lg-6">
                        <div class="tab-image-container">
                            <img src="~/images/gallery/1-campus-topdown.jpg" alt="Master Campus Map Drone View" onerror="this.src='/images/crest-placeholder.png'" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1.5 mb-2">Aerial Master Layout</span>
                        <h3 class="fw-bold text-dark mb-3">Purpose-Built Infrastructure in Upper Swat</h3>
                        <p class="text-muted" style="line-height: 1.7;">
                            Captured at a 90-degree drone elevation, the master plan of Government Degree College Madyan demonstrates an integrated architectural layout featuring symmetrical red-brick academic wings, a centralized botanical garden, administrative offices, and spacious outdoor sports grounds.
                        </p>
                        <ul class="list-unstyled text-secondary small">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Multi-story main academic block with airy, naturally lit lecture halls</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Dedicated science and computer laboratories wing</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Secure gated perimeter with mountain views of Bahrain & Miandam</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- TAB 3: GARDENS & ENVIRONMENT (Using Image #3: Botanical Gardens) -->
            <div class="tab-pane fade" id="tab-gardens" role="tabpanel" aria-labelledby="gardens-tab">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-lg-6">
                        <div class="tab-image-container">
                            <img src="~/images/gallery/3-campus-gardens.jpg" alt="Botanical Gardens and Topiary at GDC Madyan" onerror="this.src='/images/crest-placeholder.png'" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-1.5 mb-2">Eco-Friendly Campus</span>
                        <h3 class="fw-bold text-dark mb-3">Manicured Star-and-Crescent Green Lawns</h3>
                        <p class="text-muted" style="line-height: 1.7;">
                            The central quadrangle features a renowned star-and-crescent shaped botanical hedge topiary surrounded by floral borders and pine trees. Students utilize these serene green grounds for quiet study, peer discussions, and outdoor academic symposiums.
                        </p>
                        <div class="p-3 bg-light rounded border border-success border-opacity-25 small text-secondary">
                            <i class="bi bi-tree-fill text-success me-2"></i>
                            GDC Madyan participates annually in the KP Plant for Pakistan Green Drive, maintaining over 1,000 indigenous trees and ornamental shrubs.
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 4: LABS & CORRIDORS (Using Image #6: Classroom Corridors) -->
            <div class="tab-pane fade" id="tab-labs" role="tabpanel" aria-labelledby="labs-tab">
                <div class="row align-items-center g-4">
                    <div class="col-12 col-lg-6">
                        <div class="tab-image-container">
                            <img src="~/images/gallery/6-classroom-corridors.jpg" alt="Classroom Corridors and Verandas" onerror="this.src='/images/crest-placeholder.png'" />
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-3 py-1.5 mb-2">Modern Academic Facilities</span>
                        <h3 class="fw-bold text-dark mb-3">Wide Pillared Verandas & Advanced Labs</h3>
                        <p class="text-muted" style="line-height: 1.7;">
                            Designed to blend classical Pakistani academic architecture with alpine weather requirements, the college verandas connect high-speed fiber-optic computer labs, biology dissecting rooms, chemistry wet labs, and physics demonstration halls.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-light text-dark border p-2"><i class="bi bi-display me-1 text-primary"></i> 50+ Modern PCs</span>
                            <span class="badge bg-light text-dark border p-2"><i class="bi bi-wifi me-1 text-success"></i> Campus Fiber Wi-Fi</span>
                            <span class="badge bg-light text-dark border p-2"><i class="bi bi-journal me-1 text-warning"></i> 15,000+ Library Books</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 5: FULL DRONE GALLERY (Interactive Lightbox Grid of all 7 Drone Shots) -->
            <div class="tab-pane fade" id="tab-drone" role="tabpanel" aria-labelledby="drone-tab">
                <div class="text-center mb-4">
                    <h5 class="fw-bold text-dark">High-Definition Drone Photography Gallery</h5>
                    <div class="small text-muted">Click any photograph to view the full resolution image</div>
                </div>

                <div class="row g-3">
                    <!-- Image 1 -->
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="drone-grid-img-wrap" data-bs-toggle="modal" data-bs-target="#lightboxModal" data-img="/images/gallery/1-campus-topdown.jpg" data-title="Master Campus Top-Down Map">
                            <img src="~/images/gallery/1-campus-topdown.jpg" alt="Campus Top-Down" />
                            <div class="drone-grid-overlay">
                                <i class="bi bi-zoom-in fs-3 mb-1"></i>
                                <span class="small fw-bold">Top-Down Aerial</span>
                            </div>
                        </div>
                    </div>

                    <!-- Image 2 -->
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="drone-grid-img-wrap" data-bs-toggle="modal" data-bs-target="#lightboxModal" data-img="/images/gallery/2-main-academic-block.jpg" data-title="Main Academic Red-Brick Block">
