@model College_Web_Application.Models.Department
@{
    ViewData["Title"] = $"{Model.Name} - Government Degree College Madyan Swat";
    
    string deptIcon = Model.Code switch {
        "CS" => "bi-laptop-fill",
        "MCB" => "bi-virus2",
        "CHEM" => "bi-flask-fill",
        "BOT" => "bi-flower1",
        "ENG" => "bi-book-half",
        "URD" => "bi-feather",
        _ => "bi-mortarboard-fill"
    };

    var syllabi = Model.Resources.Where(r => r.Category.Equals("Syllabus", StringComparison.OrdinalIgnoreCase)).ToList();
    var books = Model.Resources.Where(r => r.Category.Equals("Book", StringComparison.OrdinalIgnoreCase)).ToList();
    var otherResources = Model.Resources.Where(r => !r.Category.Equals("Syllabus", StringComparison.OrdinalIgnoreCase) && !r.Category.Equals("Book", StringComparison.OrdinalIgnoreCase)).ToList();
}

<!-- ==========================================================================
     DEPARTMENT HERO BANNER (Top University Layout)
     ========================================================================== -->
<section class="py-5 bg-dark text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #0A1128 0%, #0B1B3D 60%, #152238 100%); border-bottom: 2px solid var(--gdc-gold);">
    <div class="container py-3 position-relative z-2">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-fragment="programs" class="text-white-50 text-decoration-none">Academics</a></li>
                <li class="breadcrumb-item active text-warning" aria-current="page">Department of @Model.Name</li>
            </ol>
        </nav>

        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning text-dark fw-bold font-monospace px-3 py-1.5 rounded-pill" style="font-size: 0.78rem;">
                        CODE: @Model.Code
                    </span>
                    <span class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-25 px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.78rem;">
                        <i class="bi bi-award-fill text-warning me-1"></i> Affiliated with University of Swat
                    </span>
                    <span class="badge bg-white bg-opacity-10 text-white border border-white border-opacity-25 px-3 py-1.5 rounded-pill fw-semibold" style="font-size: 0.78rem;">
                        Est. 2006
                    </span>
                </div>

                <h1 class="display-6 fw-bold text-white mb-2">
                    Department of <span class="text-warning">@Model.Name</span>
                </h1>

                <p class="text-white-50 fs-6 mb-3" style="max-width: 720px; line-height: 1.65;">
                    @Model.Description
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2 bg-white bg-opacity-10 px-3 py-2 rounded-3 border border-white border-opacity-15">
                        <i class="bi bi-person-badge text-warning fs-5"></i>
                        <div>
                            <div class="text-white-50 small" style="font-size: 0.72rem;">Head of Department (HOD)</div>
                            <div class="fw-bold text-white small">@Model.HODName</div>
                        </div>
                    </div>

                    @if (User.IsInRole("HOD") || User.IsInRole("Principal") || User.IsInRole("SuperAdmin"))
                    {
                        <a asp-area="Faculty" asp-controller="DepartmentManagement" asp-action="Index" asp-route-departmentId="@Model.Id" class="btn btn-warning btn-sm fw-bold rounded-pill text-dark shadow-sm">
                            <i class="bi bi-gear-fill me-1"></i> Manage Department Content (HOD Console)
                        </a>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-4 text-center text-lg-end">
                <div class="p-4 bg-white bg-opacity-5 rounded-4 border border-white border-opacity-10 d-inline-block text-start w-100" style="max-width: 340px;">
                    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-white border-opacity-10 pb-2">
                        <span class="text-white-50 small">Offered Programs</span>
                        <span class="badge bg-warning text-dark font-monospace fw-bold">@Model.Programs.Count Streams</span>
                    </div>
                    <ul class="list-unstyled mb-0 small text-white-50" style="line-height: 1.8;">
                        @foreach (var prog in Model.Programs)
                        {
                            <li class="d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-check2 text-warning me-1.5"></i>@prog.Title</span>
                                <span class="badge bg-secondary bg-opacity-50 text-white font-monospace" style="font-size: 0.68rem;">@prog.Level</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     INTERACTIVE TABS NAVIGATION
     ========================================================================== -->
<div class="bg-white border-bottom sticky-top shadow-xs" style="top: 70px; z-index: 1010;">
    <div class="container">
        <ul class="nav nav-pills department-tabs py-2 flex-nowrap overflow-x-auto" id="departmentTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold text-nowrap rounded-pill px-3 py-2" id="programs-tab" data-bs-toggle="tab" data-bs-target="#programs-content" type="button" role="tab">
                    <i class="bi bi-journal-bookmark me-1.5"></i> Programs &amp; Curricula
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold text-nowrap rounded-pill px-3 py-2" id="faculty-tab" data-bs-toggle="tab" data-bs-target="#faculty-content" type="button" role="tab">
                    <i class="bi bi-people-fill me-1.5"></i> Faculty &amp; Staff <span class="badge bg-secondary ms-1">@Model.FacultyMembers.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold text-nowrap rounded-pill px-3 py-2" id="gallery-tab" data-bs-toggle="tab" data-bs-target="#gallery-content" type="button" role="tab">
                    <i class="bi bi-images me-1.5"></i> Department Gallery <span class="badge bg-warning text-dark ms-1">@Model.GalleryItems.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold text-nowrap rounded-pill px-3 py-2" id="resources-tab" data-bs-toggle="tab" data-bs-target="#resources-content" type="button" role="tab">
                    <i class="bi bi-file-earmark-pdf-fill text-danger me-1.5"></i> Syllabi &amp; Books (PDF) <span class="badge bg-success ms-1">@Model.Resources.Count</span>
                </button>
            </li>
        </ul>
    </div>
</div>

<!-- ==========================================================================
     TAB CONTENTS CONTAINER
     ========================================================================== -->
<div class="container py-5">
    <div class="tab-content" id="departmentTabContent">
        
        <!-- ------------------------------------------------------------------
             TAB 1: PROGRAMS & CURRICULAR SCOPE
             ------------------------------------------------------------------ -->
        <div class="tab-pane fade show active" id="programs-content" role="tabpanel">
            <div class="row g-4">
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-warning bg-opacity-15 text-dark border border-warning border-opacity-30 px-3 py-1 rounded-pill fw-bold text-uppercase" style="font-size: 0.74rem;">
                                Academic Standing
                            </span>
                            <span class="text-muted small">&bull; Higher Education Department KP</span>
                        </div>
                        <h3 class="fw-bold text-dark mb-3">Mission &amp; Academic Philosophy</h3>
                        <p class="text-secondary" style="line-height: 1.8; text-align: justify;">
                            The <strong>Department of @Model.Name</strong> at Government Degree College Madyan Swat is dedicated to cultivating rigorous intellectual inquiry, scholarly excellence, and professional integrity. Guided by the curriculum prescribed by the <strong>University of Swat</strong> for undergraduate studies and <strong>BISE Swat</strong> for intermediate scholars, the department integrates foundational theory with practical laboratory investigations, field research, and modern digital competencies.
                        </p>
                        <p class="text-secondary mb-0" style="line-height: 1.8; text-align: justify;">
                            Our experienced faculty mentors encourage student participation in research seminars, technical workshops, and co-curricular academic competitions, preparing graduates for high-impact careers and competitive postgraduate opportunities.
                        </p>
                    </div>

                    <!-- Programs Offered Grid -->
                    <h4 class="fw-bold text-dark mb-3">Accredited Academic Disciplines</h4>
                    <div class="row g-3">
                        @foreach (var prog in Model.Programs)
                        {
                            <div class="col-12 col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 p-4 bg-white h-100 border-start border-4 border-warning">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-dark text-white font-monospace" style="font-size: 0.72rem;">@prog.Level</span>
                                        <span class="small text-muted font-monospace">@prog.DurationYears Years (@prog.TotalSemesters Semesters)</span>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-2">@prog.Title</h5>
                                    <div class="text-muted small mb-3">
                                        Fee per Semester: <strong>PKR @prog.FeePerSemester.ToString("N0")</strong> (Inclusive of Tuition &amp; Lab Funds)
                                    </div>
                                    <div class="mt-auto d-flex gap-2">
                                        <a asp-controller="Admissions" asp-action="Apply" class="btn btn-sm btn-outline-dark rounded-pill fw-semibold">
                                            Apply Online <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                        <a asp-controller="Admissions" asp-action="Guide" class="btn btn-sm btn-light rounded-pill fw-semibold">
                                            Curriculum Guide
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Column: HOD Profile & Quick Contacts -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle p-2 bg-light border d-flex align-items-center justify-content-center text-dark" style="width: 50px; height: 50px;">
                                <i class="bi bi-person-workspace text-warning fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small text-uppercase fw-bold" style="letter-spacing: 0.8px; font-size: 0.72rem;">Department Leadership</div>
                                <h5 class="fw-bold text-dark mb-0">@Model.HODName</h5>
                                <div class="text-secondary small">Head of Department (HOD)</div>
                            </div>
                        </div>
                        <div class="p-3 bg-light rounded-3 border small text-secondary" style="line-height: 1.6;">
                            <i class="bi bi-quote fs-4 text-warning opacity-50 float-start me-2"></i>
                            Our department strives to deliver academic rigor paired with ethical leadership. We welcome inquiries from aspiring students, parents, and academic collaborators.
                        </div>
                        <div class="mt-3 pt-3 border-top small text-muted">
                            <div><i class="bi bi-geo-alt me-2 text-warning"></i>Academic Block, GDC Madyan Swat</div>
                            <div class="mt-1"><i class="bi bi-envelope me-2 text-warning"></i>@Model.Code.ToLower()&#64;gdcmadyan.edu.pk</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ------------------------------------------------------------------
             TAB 2: FACULTY & TEACHING STAFF (Added & Maintained by HOD)
             ------------------------------------------------------------------ -->
        <div class="tab-pane fade" id="faculty-content" role="tabpanel">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Department Faculty &amp; Scholars</h3>
                    <p class="text-muted small mb-0">Teaching faculty, laboratory demonstrators, and research mentors assigned to the Department of @Model.Name.</p>
                </div>
                @if (User.IsInRole("HOD") || User.IsInRole("Principal") || User.IsInRole("SuperAdmin"))
                {
                    <a asp-area="Faculty" asp-controller="DepartmentManagement" asp-action="Index" asp-route-departmentId="@Model.Id" class="btn btn-warning btn-sm fw-bold rounded-pill text-dark shadow-sm">
                        <i class="bi bi-person-plus-fill me-1"></i> Add / Edit Faculty (HOD Console)
                    </a>
                }
            </div>

            @if (!Model.FacultyMembers.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm p-4">
                    <i class="bi bi-people text-muted opacity-50 display-4"></i>
                    <h5 class="fw-bold text-dark mt-3 mb-1">No Faculty Profiles Listed Yet</h5>
                    <p class="text-muted small">The Head of Department will update the official faculty roster shortly.</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var staff in Model.FacultyMembers)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="rounded-circle overflow-hidden bg-light border flex-shrink-0" style="width: 64px; height: 64px;">
                                        <img src="@(string.IsNullOrEmpty(staff.PhotoUrl) ? "/images/crest-placeholder.png" : staff.PhotoUrl)" 
                                             alt="@staff.FullName" 
                                             class="w-100 h-100" 
                                             style="object-fit: cover;" 
                                             onerror="this.src='/images/crest-placeholder.png'" />
                                    </div>
                                    <div class="overflow-hidden">
                                        <h5 class="fw-bold text-dark mb-0 text-truncate" title="@staff.FullName">@staff.FullName</h5>
                                        <div class="text-success small fw-semibold">@staff.Designation</div>
                                        <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.68rem;">@staff.BPSGrade</span>
                                    </div>
                                </div>
                                <div class="small text-secondary mb-3 border-top pt-2">
                                    <div class="text-muted small" style="font-size: 0.72rem;">Academic Qualification:</div>
                                    <div class="fw-semibold">@staff.Qualification</div>
                                </div>
                                <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top text-muted small" style="font-size: 0.74rem;">
                                    <span>Code: @staff.EmployeeCode</span>
                                    <span>Joined: @staff.JoiningDate.ToString("yyyy")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ------------------------------------------------------------------
             TAB 3: DEPARTMENT GALLERY (Strictly filtered to this Department)
             ------------------------------------------------------------------ -->
        <div class="tab-pane fade" id="gallery-content" role="tabpanel">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Department Photo Gallery &amp; Events</h3>
                    <p class="text-muted small mb-0">
                        Official visual archives, laboratory experiments, study trips, and academic workshops uploaded by the Head of Department.
                    </p>
                </div>
                @if (User.IsInRole("HOD") || User.IsInRole("Principal") || User.IsInRole("SuperAdmin"))
                {
                    <a asp-area="Faculty" asp-controller="DepartmentManagement" asp-action="Index" asp-route-departmentId="@Model.Id" class="btn btn-warning btn-sm fw-bold rounded-pill text-dark shadow-sm">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Gallery Picture (HOD)
                    </a>
                }
            </div>

            @if (!Model.GalleryItems.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm p-5">
                    <div class="mx-auto mb-3" style="width: 72px; height: 72px; border-radius: 50%; background: rgba(212, 175, 55, 0.15); display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-camera text-warning fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">No Gallery Pictures Yet</h5>
                    <p class="text-muted small mb-3">Pictures uploaded by the HOD of @Model.Name will appear here exclusively for this department.</p>
                    @if (User.IsInRole("HOD") || User.IsInRole("Principal") || User.IsInRole("SuperAdmin"))
                    {
                        <a asp-area="Faculty" asp-controller="DepartmentManagement" asp-action="Index" asp-route-departmentId="@Model.Id" class="btn btn-sm btn-outline-warning fw-bold text-dark rounded-pill">
                            Upload Department Photos Now
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var photo in Model.GalleryItems)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100">
                                <div class="position-relative overflow-hidden" style="height: 220px; background-color: #0A1128;">
                                    <img src="@photo.ImageUrl" 
                                         alt="@photo.Title" 
                                         class="w-100 h-100 d-block" 
                                         style="object-fit: cover; transition: transform 0.3s ease;"
                                         onmouseover="this.style.transform='scale(1.05)'"
                                         onmouseout="this.style.transform='scale(1)'"
                                         onerror="this.src='/images/gallery/2-main-academic-block.jpg'" />
                                    
                                    <div class="position-absolute top-0 end-0 m-2">
                                        <span class="badge bg-dark bg-opacity-75 text-warning border border-warning border-opacity-50 px-2 py-1 rounded-pill" style="font-size: 0.68rem;">
                                            <i class="bi bi-shield-check me-1"></i> Official HOD Upload
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body p-3 d-flex flex-column">
                                    <h6 class="fw-bold text-dark mb-1">@photo.Title</h6>
                                    @if (!string.IsNullOrEmpty(photo.Caption))
                                    {
                                        <p class="text-secondary small mb-3" style="line-height: 1.5; font-size: 0.8rem;">
                                            @photo.Caption
                                        </p>
                                    }
                                    <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top text-muted small" style="font-size: 0.72rem;">
                                        <span><i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(photo.UploadedBy) ? Model.HODName : photo.UploadedBy)</span>
                                        <span>@photo.UploadedAt.ToString("MMM yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ------------------------------------------------------------------
             TAB 4: ACADEMIC RESOURCES (Syllabi, Curriculum & Books in PDF)
             ------------------------------------------------------------------ -->
        <div class="tab-pane fade" id="resources-content" role="tabpanel">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Academic Syllabi, Course Schemes &amp; Books (PDF)</h3>
                    <p class="text-muted small mb-0">Official University of Swat curricula, lecture outlines, and recommended textbooks published by the HOD.</p>
                </div>
                @if (User.IsInRole("HOD") || User.IsInRole("Principal") || User.IsInRole("SuperAdmin"))
                {
                    <a asp-area="Faculty" asp-controller="DepartmentManagement" asp-action="Index" asp-route-departmentId="@Model.Id" class="btn btn-warning btn-sm fw-bold rounded-pill text-dark shadow-sm">
                        <i class="bi bi-file-earmark-plus-fill me-1"></i> Upload Book / Syllabus PDF (HOD)
                    </a>
                }
            </div>

            <!-- 1. Syllabi Section -->
            <div class="mb-5">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1.5 rounded-pill fw-bold" style="font-size: 0.76rem;">
                        <i class="bi bi-file-earmark-text-fill me-1"></i> Curricula &amp; Schemes of Studies
                    </span>
                    <h4 class="fw-bold text-dark mb-0 fs-5">Approved Schemes of Studies</h4>
                </div>

                @if (!syllabi.Any())
                {
                    <div class="p-3 bg-white rounded-3 border text-muted small">No syllabus documents uploaded yet for this department.</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var item in syllabi)
                        {
                            <div class="col-12 col-md-6">
                                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 d-flex flex-row align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-3 overflow-hidden">
                                        <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3 flex-shrink-0">
                                            <i class="bi bi-file-earmark-pdf-fill fs-3"></i>
                                        </div>
                                        <div class="overflow-hidden">
                                            <h6 class="fw-bold text-dark mb-0 text-truncate" title="@item.Title">@item.Title</h6>
                                            <div class="text-muted small" style="font-size: 0.74rem;">
                                                @(string.IsNullOrEmpty(item.AuthorOrPublisher) ? "University of Swat" : item.AuthorOrPublisher)
                                                &bull; @((item.FileSizeBytes / (1024.0 * 1024.0)).ToString("0.0")) MB
                                            </div>
                                        </div>
                                    </div>
                                    <a href="@item.FileUrl" download target="_blank" class="btn btn-sm btn-outline-danger rounded-pill fw-semibold flex-shrink-0">
                                        <i class="bi bi-download me-1"></i> PDF
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- 2. Recommended Books Section -->
            <div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill fw-bold" style="font-size: 0.76rem;">
                        <i class="bi bi-book-half me-1"></i> Recommended Textbooks &amp; References
                    </span>
                    <h4 class="fw-bold text-dark mb-0 fs-5">Recommended Textbooks &amp; Reference Materials</h4>
                </div>

                @if (!books.Any())
                {
                    <div class="p-3 bg-white rounded-3 border text-muted small">No recommended books uploaded yet for this department.</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var book in books)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.7rem;">
                                                @(book.TargetSemester.HasValue ? $"Semester {book.TargetSemester}" : "All Semesters")
                                            </span>
                                            <span class="text-muted small" style="font-size: 0.72rem;">@((book.FileSizeBytes / (1024.0 * 1024.0)).ToString("0.0")) MB</span>
                                        </div>
                                        <h6 class="fw-bold text-dark mb-1">@book.Title</h6>
                                        <div class="text-secondary small mb-3" style="font-size: 0.78rem;">
                                            <i class="bi bi-pen me-1 text-warning"></i>Author: <strong>@(string.IsNullOrEmpty(book.AuthorOrPublisher) ? "Recommended by HOD" : book.AuthorOrPublisher)</strong>
                                        </div>
                                    </div>
                                    <div class="pt-2 border-top mt-auto">
                                        <a href="@book.FileUrl" download target="_blank" class="btn btn-sm btn-outline-success rounded-pill fw-semibold w-100">
                                            <i class="bi bi-download me-1.5"></i> Download Reference Book (PDF)
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (otherResources.Any())
            {
                <div class="mt-5">
                    <h5 class="fw-bold text-dark mb-3">Additional Academic Documents &amp; Lab Manuals</h5>
                    <div class="row g-3">
                        @foreach (var doc in otherResources)
                        {
                            <div class="col-12 col-md-6">
