@model College_Web_Application.Models.ViewModels.MeritListFilterViewModel
@{
    ViewData["Title"] = "Official Academic Merit Lists - Fall 2026";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Admissions" asp-action="Apply" class="text-decoration-none text-success">Admissions</a></li>
                <li class="breadcrumb-item active" aria-current="page">Merit Lists</li>
            </ol>
        </nav>
        <div class="text-success fw-bold arabic-motto" style="font-size: 1.1rem;">
            رَبِّ زِدْنِي عِلْماً
        </div>
    </div>

    <!-- Header Banner -->
    <div class="bg-success text-white p-4 p-md-5 rounded-4 shadow-sm mb-4" 
         style="background: linear-gradient(135deg, #084C1A 0%, #0B6623 50%, #145A32 100%);">
        <div class="row align-items-center">
            <div class="col-12 col-md-8">
                <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill fw-bold text-uppercase mb-2">
                    <i class="bi bi-award-fill me-1"></i> Admissions Fall 2026 Session
                </span>
                <h1 class="h2 fw-bold text-white mb-2">Official Institutional Merit Lists</h1>
                <p class="text-white-50 mb-0">
                    Transparent, merit-based selection lists for BS 4-Year and Intermediate programs at Government Degree College Madyan Swat.
                </p>
            </div>
            <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-action="Apply" class="btn btn-warning fw-bold shadow">
                    <i class="bi bi-pencil-square me-1"></i> Submit New Application
                </a>
            </div>
        </div>
    </div>

    <!-- Top Summary Metrics (Seat Capacity, Total Applicants, Cut-off) -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <span class="text-muted small fw-semibold text-uppercase">Total Applications Received</span>
                <div class="h2 fw-bold text-dark mt-1 mb-0">@Model.TotalCount</div>
                <small class="text-success mt-auto pt-2"><i class="bi bi-check2-circle me-1"></i> Verified on Open Merit & Quota</small>
            </div>
        </div>

        <div class="col-12 col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <span class="text-muted small fw-semibold text-uppercase">Program Seat Capacity</span>
                <div class="h2 fw-bold text-dark mt-1 mb-0">60 - 120 <small class="text-muted fw-normal fs-6">per program</small></div>
                <small class="text-primary mt-auto pt-2"><i class="bi bi-building me-1"></i> HED KP Allocated Seats</small>
            </div>
        </div>

        <div class="col-12 col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <span class="text-muted small fw-semibold text-uppercase">Current Cut-off Merit</span>
                <div class="h2 fw-bold text-success mt-1 mb-0">@Model.CutOffMeritPercentage.ToString("0.00")%</div>
                <small class="text-muted mt-auto pt-2"><i class="bi bi-graph-up me-1"></i> Subject to Interview Verification</small>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form asp-action="MeritLists" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <select name="programId" class="form-select form-select-sm">
                    <option value="">All Academic Programs</option>
                    @foreach (var prog in Model.Programs)
                    {
                        <option value="@prog.Id" selected="@(Model.ProgramId == prog.Id)">@prog.Title (@prog.Level)</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3">
                <select name="quota" class="form-select form-select-sm">
                    <option value="All" selected="@(Model.QuotaCategory == "All")">All Quotas</option>
                    <option value="Open Merit" selected="@(Model.QuotaCategory == "Open Merit")">Open Merit</option>
                    <option value="Sports" selected="@(Model.QuotaCategory == "Sports")">Sports Quota</option>
                    <option value="Disabled" selected="@(Model.QuotaCategory == "Disabled")">Disabled Quota</option>
                    <option value="Hafiz-e-Quran" selected="@(Model.QuotaCategory == "Hafiz-e-Quran")">Hafiz-e-Quran Quota</option>
                </select>
            </div>

            <div class="col-6 col-md-4">
                <div class="input-group input-group-sm">
                    <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Search by name, CNIC, or tracking #..." />
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>

            <div class="col-12 col-md-1">
                <a asp-action="MeritLists" class="btn btn-outline-secondary btn-sm w-100" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Merit List Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">
                <i class="bi bi-list-ol text-success me-1"></i> Merit Ranking Order
            </span>
            <span class="badge bg-light text-secondary border">
                Showing @Model.Applications.Count of @Model.TotalCount Applicants
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Rank</th>
                        <th>Tracking #</th>
                        <th>Applicant Particulars</th>
                        <th>CNIC / Form-B</th>
                        <th>Program</th>
                        <th>Quota</th>
                        <th class="text-end">Merit Score (%)</th>
                        <th class="text-center">Status</th>
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Principal") || User.IsInRole("Clerk"))
                        {
                            <th class="text-end">Admin Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Applications.Any())
                    {
                        int rank = ((Model.CurrentPage - 1) * Model.PageSize);
                        foreach (var app in Model.Applications)
                        {
                            rank++;
                            <tr>
                                <td>
                                    <span class="badge @(rank <= 3 ? "bg-warning text-dark font-monospace fw-bold" : "bg-light text-secondary border")">
                                        #@rank
                                    </span>
                                </td>
                                <td class="font-monospace fw-semibold text-dark">@app.TrackingNumber</td>
                                <td>
                                    <div class="fw-bold text-dark">@app.ApplicantName</div>
                                    <div class="text-muted small">S/O @app.FatherName</div>
                                </td>
                                <td class="font-monospace text-muted">@app.CNIC</td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                        @app.AppliedProgram?.Title
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@app.QuotaCategory</span>
                                    @if (app.IsHafizQuran)
                                    {
                                        <span class="badge bg-info text-dark ms-1" title="Hafiz Bonus Applied">+20</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="h6 fw-bold text-success mb-0">@app.MeritScore.ToString("0.00")%</span>
                                </td>
                                <td class="text-center">
                                    @if (app.Status == "Admitted")
                                    {
                                        <span class="badge bg-success px-2 py-1">Admitted</span>
                                    }
                                    else if (app.Status == "MeritListed")
                                    {
                                        <span class="badge bg-primary px-2 py-1">Selected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">Pending</span>
                                    }
                                </td>
                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Principal") || User.IsInRole("Clerk"))
                                {
                                    <td class="text-end">
                                        @if (app.Status != "Admitted")
                                        {
                                            <a asp-area="Admin" asp-controller="Students" asp-action="EnrollApplicant" asp-route-applicationId="@app.Id"
                                               class="btn btn-outline-success btn-sm py-0 px-2 fw-semibold">
                                                <i class="bi bi-person-plus-fill me-1"></i> Enroll
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-check2 me-1"></i> Enrolled</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-file-earmark-person fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No applicants found matching the selected program or criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div class="text-muted small">
                    Page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="MeritLists" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-programId="@Model.ProgramId" 
                               asp-route-quota="@Model.QuotaCategory" 
                               asp-route-search="@Model.SearchQuery">
                                Previous
                            </a>
                        </li>
                        
                        @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="MeritLists" 
                                   asp-route-page="@p" 
                                   asp-route-programId="@Model.ProgramId" 
                                   asp-route-quota="@Model.QuotaCategory" 
                                   asp-route-search="@Model.SearchQuery">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="MeritLists" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-programId="@Model.ProgramId" 
                               asp-route-quota="@Model.QuotaCategory" 
                               asp-route-search="@Model.SearchQuery">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
