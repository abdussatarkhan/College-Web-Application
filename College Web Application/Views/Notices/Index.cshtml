@model College_Web_Application.Models.ViewModels.NoticeListViewModel
@{
    ViewData["Title"] = "Digital Notice Board & Downloads";
}

<div class="container py-4">
    <!-- Breadcrumb & Motto -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Digital Notice Board</li>
            </ol>
        </nav>
        <div class="text-success fw-bold arabic-motto" style="font-size: 1.1rem;">
            رَبِّ زِدْنِي عِلْماً
        </div>
    </div>

    <!-- Main Banner Header -->
    <div class="bg-success text-white p-4 p-md-5 rounded-4 shadow-sm mb-4 position-relative overflow-hidden" 
         style="background: linear-gradient(135deg, #084C1A 0%, #0B6623 50%, #145A32 100%);">
        <div class="row align-items-center">
            <div class="col-12 col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill fw-bold text-uppercase mb-2" style="letter-spacing: 0.8px;">
                    <i class="bi bi-bell-fill me-1"></i> Public Circulars & Notifications
                </span>
                <h1 class="h2 fw-bold text-white mb-2">Digital Notice Board & Downloads</h1>
                <p class="text-white-50 mb-0">
                    Official announcements, BISE Swat date sheets, University of Swat semester schedules, and government scholarship circulars.
                </p>
            </div>
            <div class="col-12 col-lg-4 text-lg-end mt-3 mt-lg-0">
                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Principal") || User.IsInRole("Clerk"))
                {
                    <a asp-controller="Notices" asp-action="Create" class="btn btn-warning fw-semibold shadow">
                        <i class="bi bi-plus-circle-fill me-1"></i> Publish New Notice
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Success Message Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Pills & Search Bar -->
    <div class="card border-0 shadow-sm mb-4 p-3 bg-white rounded-3">
        <div class="row g-3 align-items-center">
            <!-- Category Filter Pills -->
            <div class="col-12 col-lg-8">
                <div class="d-flex flex-wrap gap-1.5">
                    @foreach (var cat in Model.Categories)
                    {
                        bool isSelected = string.Equals(Model.SelectedCategory, cat, StringComparison.OrdinalIgnoreCase);
                        <a asp-action="Index" asp-route-category="@cat" asp-route-search="@Model.SearchKeyword"
                           class="btn btn-sm rounded-pill px-3 @(isSelected ? "btn-success fw-bold" : "btn-outline-secondary")">
                            @cat
                        </a>
                    }
                </div>
            </div>

            <!-- Search Keyword Form -->
            <div class="col-12 col-lg-4">
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="hidden" name="category" value="@Model.SelectedCategory" />
                    <div class="input-group input-group-sm">
                        <input type="text" name="search" value="@Model.SearchKeyword" class="form-control" placeholder="Search notices by keyword..." />
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.SearchKeyword))
                    {
                        <a asp-action="Index" asp-route-category="@Model.SelectedCategory" class="btn btn-sm btn-outline-secondary" title="Clear Search">
                            <i class="bi bi-x"></i>
                        </a>
                    }
                </form>
            </div>
        </div>
    </div>

    <!-- Notices Stream -->
    <div class="row g-4">
        @if (Model.Notices.Any())
        {
            foreach (var notice in Model.Notices)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3 p-4 position-relative transition-hover @(notice.IsPinned ? "border-start border-4 border-success bg-light bg-opacity-50" : "bg-white")">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    @if (notice.IsPinned)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1">
                                            <i class="bi bi-pin-angle-fill me-1"></i> Pinned
                                        </span>
                                    }

                                    @if (notice.Category == "Admission")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                            Admission
                                        </span>
                                    }
                                    else if (notice.Category == "Exam")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5 py-1">
                                            Examination
                                        </span>
                                    }
                                    else if (notice.Category == "Scholarship")
                                    {
                                        <span class="badge bg-warning bg-opacity-20 text-dark border border-warning border-opacity-50 rounded-pill px-2.5 py-1">
                                            Scholarship
                                        </span>
                                    }
                                    else if (notice.Category == "TimeTable")
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-dark border border-info border-opacity-25 rounded-pill px-2.5 py-1">
                                            Time Table
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2.5 py-1">
                                            General Notice
                                        </span>
                                    }

                                    <span class="text-muted small">
                                        <i class="bi bi-calendar3 me-1"></i> @notice.PublishedDate.ToString("dd MMMM yyyy")
                                    </span>
                                </div>

                                <h4 class="h5 fw-bold text-dark mb-2">@notice.Title</h4>
                                <p class="text-muted mb-0" style="font-size: 0.95rem; line-height: 1.6;">
                                    @notice.Description
                                </p>
                            </div>

                            <!-- Actions / Downloads -->
                            <div class="d-flex flex-md-column gap-2 align-items-end flex-shrink-0">
                                @if (!string.IsNullOrEmpty(notice.AttachmentPdfUrl))
                                {
                                    <a href="@notice.AttachmentPdfUrl" target="_blank" class="btn btn-outline-success btn-sm px-3 shadow-sm text-nowrap">
                                        <i class="bi bi-file-earmark-pdf-fill me-1 text-danger"></i> Download PDF
                                    </a>
                                }

                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Principal") || User.IsInRole("Clerk"))
                                {
                                    <form asp-action="Delete" asp-route-id="@notice.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this notice?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm p-1 px-2" title="Delete Notice">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm p-5 text-center bg-white rounded-4">
                    <i class="bi bi-inbox fs-1 text-muted mb-3 opacity-50"></i>
                    <h5 class="fw-bold text-dark">No notices found</h5>
                    <p class="text-muted mb-3">No official notices match your selected category or keyword.</p>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-success btn-sm">Reset All Filters</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
